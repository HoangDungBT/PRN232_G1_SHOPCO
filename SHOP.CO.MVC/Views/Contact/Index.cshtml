@model SHOP.CO.MVC.Models.ContactViewModel

<div class="page-wrapper">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px; align-items: start;">
        <div>
            <h1 class="page-title" style="margin-top: 0;">Liên hệ với chúng tôi</h1>
            <p style="color: #666; line-height: 1.8; margin-bottom: 20px;">
                Bạn có thắc mắc về đơn hàng , chính sách đổi trả hoặc cần hỗ trợ gấp ? Đội ngũ SHOP.CO luôn sẵn sàng lắng nghe và phản hồi bạn trong vòng 24 giờ.
            </p>
            <div style="margin-top: 30px;">
                <p><strong>📧 Email:</strong> 123123123.com</p>
                <p><strong>📞 Hotline:</strong> (84+) 37 37 19 399</p>
                <p><strong>📍 Địa chỉ:</strong> Vĩnh Long</p>
            </div>
        </div>

        <div class="custom-card">
            <form asp-action="Send" method="post">
                <div class="form-group">
                    <label class="form-label">Họ và tên</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger" style="color:red; font-size:13px;"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger" style="color:red; font-size:13px;"></span>
                </div>
                <div class="form-group">
                    <label class="form-label">Nội dung</label>
                    <textarea asp-for="Message" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Message" class="text-danger" style="color:red; font-size:13px;"></span>
                </div>
                <button type="submit" class="btn-primary" style="width: 100%;">Gửi liên hệ</button>
            </form>
        </div>
    </div>
</div>