@{
    ViewData["Title"] = "VNPay Payment Simulation - SHOP.CO";
    var orderCode = ViewBag.OrderCode as string ?? "N/A";
    var totalAmount = (decimal)(ViewBag.TotalAmount ?? 0m);
}

<style>
    .vnpay-page {
        max-width: 560px;
        margin: 60px auto;
        padding: 0 16px;
        text-align: center;
    }

    .vnpay-logo {
        font-size: 3rem;
        margin-bottom: 8px;
    }

    .vnpay-badge {
        display: inline-block;
        background: #0066cc;
        color: #fff;
        border-radius: 8px;
        padding: 4px 14px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 32px;
    }

    .vnpay-card {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 20px;
        padding: 36px 32px;
        margin-bottom: 28px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        text-align: left;
    }

    .vnpay-card h2 {
        font-size: 1.3rem;
        font-weight: 800;
        margin-bottom: 20px;
        color: #111;
        border-bottom: 1px solid #f0f0f0;
        padding-bottom: 14px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #f5f5f5;
        font-size: 15px;
    }

    .detail-row:last-child { border-bottom: none; }
    .detail-row .lbl { color: #888; }
    .detail-row .val { font-weight: 700; color: #111; }
    .detail-row.amount .val { font-size: 1.3rem; color: #0066cc; }

    .sim-label {
        display: inline-block;
        background: #fff3cd;
        border: 1px solid #ffc107;
        color: #856404;
        border-radius: 8px;
        padding: 10px 18px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 24px;
        width: 100%;
        text-align: center;
    }

    .btn-success-sim {
        width: 100%;
        padding: 16px;
        background: #16a34a;
        color: #fff;
        border: none;
        border-radius: 40px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
        margin-bottom: 12px;
    }

    .btn-success-sim:hover { background: #15803d; }

    .btn-fail-sim {
        width: 100%;
        padding: 16px;
        background: #fff;
        color: #dc2626;
        border: 2px solid #dc2626;
        border-radius: 40px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-fail-sim:hover {
        background: #dc2626;
        color: #fff;
    }
</style>

<div class="vnpay-page">
    <div class="vnpay-logo">💳</div>
    <div class="vnpay-badge">VNPay Sandbox</div>

    <div class="vnpay-card">
        <h2>Payment Details</h2>
        <div class="detail-row">
            <span class="lbl">Order Code</span>
            <span class="val">@orderCode</span>
        </div>
        <div class="detail-row">
            <span class="lbl">Merchant</span>
            <span class="val">SHOP.CO Demo</span>
        </div>
        <div class="detail-row">
            <span class="lbl">Currency</span>
            <span class="val">VND</span>
        </div>
        <div class="detail-row amount">
            <span class="lbl">Amount</span>
            <span class="val">@totalAmount.ToString("N0") ₫</span>
        </div>
    </div>

    <div class="sim-label">
        ⚠️ Sandbox Simulation Mode — No real payment is processed
    </div>

    <form asp-action="SimulateVnpay" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="orderCode" value="@orderCode" />
        <input type="hidden" name="totalAmount" value="@totalAmount" />
        <input type="hidden" name="simulateSuccess" value="true" id="simSuccessInput" />

        <button type="submit" class="btn-success-sim" onclick="document.getElementById('simSuccessInput').value='true'">
            ✅ Simulate Payment Success
        </button>
    </form>

    <form asp-action="SimulateVnpay" method="post" class="mt-0">
        @Html.AntiForgeryToken()
        <input type="hidden" name="orderCode" value="@orderCode" />
        <input type="hidden" name="totalAmount" value="@totalAmount" />
        <input type="hidden" name="simulateSuccess" value="false" />

        <button type="submit" class="btn-fail-sim">
            ❌ Simulate Payment Failure
        </button>
    </form>
</div>
