<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SHOP.CO</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>

<body>

    <!-- TOP BAR -->

    <div class="top-bar">

        Sign up and get 20% off to your first order.

    </div>

    <!-- NAVBAR -->

    <nav class="navbar">

        <div class="logo">
            SHOP.CO
        </div>

        <ul class="nav-links">
            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li><a asp-controller="Home" asp-action="Category">Shop</a></li>
            <li><a href="#">On Sale</a></li>
            <li><a href="#">New Arrivals</a></li>
            <li><a href="#">Brands</a></li>
            

        <div class="search-box">

            <input type="text" placeholder="Search for products..." />

        </div>
            <div class="nav-icons">
                <!-- Giỏ hàng -->
                <a href="/Home/Cart" style="text-decoration: none; font-size: 24px; color: black; display: inline-block; margin-right: 15px;">🛒</a>

                <!-- Menu Tài khoản thay cho nút 👤 -->
                <div class="dropdown">
                    <button class="dropbtn">
                        <span>👤▾</span>
                    </button>
                    <div class="dropdown-content">
                        <a asp-controller="User" asp-action="Profile">Hồ sơ</a>
                        <a asp-controller="User" asp-action="AddressBook">Sổ địa chỉ</a>
                        <a asp-controller="Order" asp-action="History">Lịch sử đơn hàng</a>
                        <a asp-controller="Notification" asp-action="Index">Thông báo</a>
                        <hr style="margin: 5px 0; border: 0; border-top: 1px solid #eee;">
                        <a href="#">Đăng xuất</a>
                    </div>
                </div>
            </div>


    </nav>

    <!-- BODY -->
    <div class="container">
        @* Hiển thị thông báo thành công/lỗi từ Controller *@
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" style="padding: 10px; background: #d4edda; color: #155724; border: 1px solid #c3e6cb; margin: 15px 0;">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" style="padding: 10px; background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; margin: 15px 0;">
                @TempData["Error"]
            </div>
        }

        @RenderBody()
    </div>

    <!-- NEWSLETTER -->

    <section class="newsletter">

        <div class="newsletter-left">

            <h2>
                STAY UPTO DATE ABOUT OUR LATEST OFFERS
            </h2>

        </div>

        <div class="newsletter-right">

            <input type="email" placeholder="Enter your email address" />

            <button>
                Subscribe to Newsletter
            </button>

        </div>

    </section>

    <!-- FOOTER -->

    <footer class="footer">

        <div class="footer-top">

            <div class="footer-brand">

                <h2>SHOP.CO</h2>

                <p>
                    We have clothes that suits your style and which you’re proud to wear.
                </p>

            </div>

            <div class="footer-links">

                <div>

                    <h4>COMPANY</h4>

                    <a asp-controller="Home" asp-action="AboutUs">About</a>
                    <a href="#">Features</a>
                    <a href="#">Works</a>

                </div>

                <div>

                    <h4>HELP</h4>

                    <a href="#">Support</a>
                    <a href="#">Delivery</a>
                    <a href="#">Terms</a>

                </div>

                <div>

                    <h4>FAQ</h4>

                    <a asp-controller="Home" asp-action="Faq">FAQ</a>
                    <a asp-controller="Order" asp-action="History">Orders</a>
                    <a asp-controller="Contact" asp-action="Index">Payments / Contact</a>

                </div>

            </div>

        </div>

        <div class="footer-bottom">

            © 2026 SHOP.CO. All Rights Reserved.

        </div>

    </footer>

</body>

</html>