@using Microsoft.AspNetCore.Http
@using SHOP.CO.MVC.Common
@inject IHttpContextAccessor HttpContextAccessor

@{
    var token = HttpContextAccessor.HttpContext?.Session.GetString(MvcConstants.SessionToken);
    var fullName = HttpContextAccessor.HttpContext?.Session.GetString(MvcConstants.SessionFullName);
    var role = HttpContextAccessor.HttpContext?.Session.GetString(MvcConstants.SessionRole);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SHOP.CO</title>
    <!-- CSS Bootstrap 5 (needed for grid, dropdowns, and admin forms) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SHOP.CO.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- TOP BAR -->
    <div class="top-bar">
        <span>Sign up and get 20% off to your first order. <a href="/Auth/Register" style="color: white; text-decoration: underline; font-weight: 600;">Sign Up Now</a></span>
        <button class="top-bar-close" onclick="this.parentElement.style.display='none'">&times;</button>
    </div>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="logo">
            <a href="/" style="text-decoration: none; color: black; font-family: 'Poppins', sans-serif; font-weight: 800; letter-spacing: -0.5px;">SHOP.CO</a>
        </div>

        <ul class="nav-links">
            <li class="dropdown">
                <a href="/Home/Category">Shop <span style="font-size: 10px;">▼</span></a>
            </li>
            <li>
                <a href="#">On Sale</a>
            </li>
            <li>
                <a href="#">New Arrivals</a>
            </li>
            <li>
                <a href="#">Brands</a>
            </li>
        </ul>

        <div class="search-box">
            <span class="search-icon" style="cursor: pointer;" onclick="triggerHeaderSearch()">🔍</span>
            <input type="text" id="headerSearchInput" placeholder="Search for products..." value="@ViewBag.SearchTerm" onkeypress="handleSearchKeyPress(event)" />
        </div>

        <div class="nav-icons">
            <a href="/Home/Wishlist" class="nav-icon" title="Danh sách yêu thích" style="text-decoration: none; font-size: 16px;">❤️</a>
            <a href="/Cart" class="nav-icon">🛒</a>
            @if (string.IsNullOrEmpty(token))
            {
                <a href="/Auth/Login" class="nav-icon" title="Đăng nhập">👤</a>
            }
            else
            {
                <div class="dropdown d-inline-block">
                    <a href="#" class="nav-icon dropdown-toggle text-dark" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="text-decoration: none; font-size: 16px;">
                        👤 <span style="font-size: 14px; font-weight: 500; font-family: 'Plus Jakarta Sans', sans-serif;">@fullName</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown" style="border-radius: 8px; border: 1px solid #eee; margin-top: 10px;">
                        @if (role == "Admin" || role == "Staff")
                        {
                            <li><a class="dropdown-item text-danger fw-bold" href="/Admin/Dashboard">Khu Vực Quản Trị</a></li>
                            <li><hr class="dropdown-divider"></li>
                        }
                        <li><a class="dropdown-item" href="/Profile">Trang Cá Nhân</a></li>
                        <li><a class="dropdown-item" href="/Cart">Giỏ Hàng</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/Auth/Logout">Đăng Xuất</a></li>
                    </ul>
                </div>
            }
        </div>
    </nav>

    <!-- BODY -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- NEWSLETTER -->
    <section class="newsletter">
        <div class="newsletter-left">
            <h2>STAY UPTO DATE ABOUT OUR LATEST OFFERS</h2>
        </div>
        <div class="newsletter-right">
            <div class="input-with-icon">
                <span class="email-icon">✉</span>
                <input type="email" placeholder="Enter your email address" />
            </div>
            <button>Subscribe to Newsletter</button>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer-top">
            <div class="footer-brand">
                <h2>SHOP.CO</h2>
                <p>We have clothes that suits your style and which you're proud to wear. From women to men.</p>
                <div class="social-links">
                    <a href="#">🐦</a>
                    <a href="#" class="social-active">📘</a>
                    <a href="#">📷</a>
                    <a href="#">🐙</a>
                </div>
            </div>
            <div class="footer-links">
                <div>
                    <h4>COMPANY</h4>
                    <a href="#">About</a>
                    <a href="#">Features</a>
                    <a href="#">Works</a>
                    <a href="#">Career</a>
                </div>
                <div>
                    <h4>HELP</h4>
                    <a href="#">Customer Support</a>
                    <a href="#">Delivery Details</a>
                    <a href="#">Terms & Conditions</a>
                    <a href="#">Privacy Policy</a>
                </div>
                <div>
                    <h4>FAQ</h4>
                    <a href="#">Account</a>
                    <a href="#">Manage Deliveries</a>
                    <a href="#">Orders</a>
                    <a href="#">Payments</a>
                </div>
                <div>
                    <h4>RESOURCES</h4>
                    <a href="#">Free eBooks</a>
                    <a href="#">Development Tutorial</a>
                    <a href="#">How to - Blog</a>
                    <a href="#">Youtube Playlist</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>Shop.co © 2000-2023, All Rights Reserved</p>
            <div class="payment-methods">
                <span class="payment-card">Visa</span>
                <span class="payment-card">Mastercard</span>
                <span class="payment-card">PayPal</span>
                <span class="payment-card">Apple Pay</span>
                <span class="payment-card">Google Pay</span>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        $(document).ready(function () {
            // Lấy đường dẫn URL hiện tại
            var currentPath = window.location.pathname;

            // Tìm thẻ <a> trong sidebar có href khớp với đường dẫn hiện tại và thêm class 'active'
            $('.sidebar a').each(function () {
                var href = $(this).attr('href');
                if (href !== '/' && currentPath.startsWith(href)) {
                    $(this).css({
                        'background-color': '#495057',
                        'color': '#fff',
                        'border-left': '4px solid #0d6efd'
                    });
                }
            });
        });

        function triggerHeaderSearch() {
            var keyword = document.getElementById("headerSearchInput").value.trim();
            window.location.href = "/Home/Category?searchTerm=" + encodeURIComponent(keyword);
        }

        function handleSearchKeyPress(event) {
            if (event.key === "Enter") {
                triggerHeaderSearch();
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
