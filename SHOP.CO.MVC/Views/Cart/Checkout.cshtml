@model SHOP.CO.MVC.Models.CartViewModel

@{
    ViewData["Title"] = "Checkout - SHOP.CO";
    var addresses = ViewBag.Addresses as List<SHOP.CO.MVC.Models.UserAddressViewModel> ?? new List<SHOP.CO.MVC.Models.UserAddressViewModel>();
}

<style>
    body {
        background-color: #f9fafb;
    }

    .checkout-page {
        padding: 48px 20px 80px;
        max-width: 1200px;
        margin: 0 auto;
    }

    @@media (min-width: 992px) {
        .checkout-page { padding: 64px 40px 80px; }
    }

    .checkout-title {
        font-size: 2.25rem;
        font-weight: 800;
        letter-spacing: -1px;
        color: #111;
        margin-bottom: 8px;
    }

    .checkout-subtitle {
        color: #6b7280;
        font-size: 1.05rem;
        margin-bottom: 40px;
    }

    /* Cards */
    .checkout-card {
        background: #ffffff;
        border: 1px solid #f3f4f6;
        border-radius: 24px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.04);
        padding: 32px;
        margin-bottom: 24px;
    }

    .checkout-card-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: #111;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .checkout-card-title span.step-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: #111;
        color: #fff;
        border-radius: 50%;
        font-size: 0.9rem;
    }

    /* Address Cards */
    .address-cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }

    @@media (min-width: 768px) {
        .address-cards { grid-template-columns: 1fr 1fr; }
    }

    .address-card {
        border: 2px solid #e5e7eb;
        border-radius: 16px;
        padding: 24px;
        cursor: pointer;
        position: relative;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        background: #fff;
    }

    .address-card:hover {
        border-color: #d1d5db;
        transform: translateY(-2px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.06);
    }

    .address-card.selected {
        border-color: #111;
        background: #fafafa;
    }

    .address-type-badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 999px;
        margin-bottom: 12px;
        background: #e5e7eb;
        color: #4b5563;
        transition: all 0.2s;
    }

    .address-card.selected .address-type-badge {
        background: #111;
        color: #fff;
    }

    .address-card input[type="radio"] {
        position: absolute;
        top: 24px;
        right: 24px;
        accent-color: #111;
        transform: scale(1.2);
    }

    .address-name {
        font-weight: 800;
        font-size: 1.05rem;
        color: #111;
        margin-bottom: 6px;
    }

    .address-phone {
        font-size: 0.9rem;
        color: #4b5563;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .address-detail {
        font-size: 0.9rem;
        color: #374151;
        line-height: 1.5;
    }

    /* Note input */
    .note-section textarea {
        border-radius: 16px;
        padding: 20px;
        border: 2px solid #e5e7eb;
        font-size: 0.95rem;
        width: 100%;
        outline: none;
        resize: vertical;
        transition: border-color 0.2s;
        background: #fafafa;
    }

    .note-section textarea:focus {
        border-color: #111;
        background: #fff;
    }

    /* Method Selector */
    .payment-method-selector {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }

    @@media (min-width: 576px) {
        .payment-method-selector { grid-template-columns: 1fr 1fr; }
    }

    .method-card {
        border: 2px solid #e5e7eb;
        border-radius: 16px;
        padding: 24px;
        cursor: pointer;
        text-align: center;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        background: #fff;
        position: relative;
    }

    .method-card:hover {
        border-color: #d1d5db;
        transform: translateY(-2px);
    }

    .method-card.selected {
        border-color: #111;
        background: #111;
        color: #fff;
        box-shadow: 0 12px 24px rgba(17,17,17,0.15);
    }

    .method-card input[type="radio"] {
        position: absolute;
        opacity: 0;
    }

    .method-card .icon {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 12px;
    }

    .method-card h4 {
        font-size: 1rem;
        font-weight: 800;
        margin: 0;
    }

    /* Checkout summary sidebar */
    .checkout-summary {
        background: #ffffff;
        border: 1px solid #f3f4f6;
        border-radius: 24px;
        box-shadow: 0 4px 32px rgba(0,0,0,0.06);
        padding: 32px;
        position: sticky;
        top: 32px;
    }

    .checkout-summary h3 {
        font-size: 1.25rem;
        font-weight: 800;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f3f4f6;
        color: #111;
    }

    .checkout-item {
        display: flex;
        justify-content: space-between;
        font-size: 0.95rem;
        margin-bottom: 16px;
        align-items: center;
    }

    .checkout-item .name {
        font-weight: 600;
        color: #374151;
        max-width: 65%;
        line-height: 1.3;
    }

    .checkout-item .price {
        font-weight: 700;
        color: #111;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        font-size: 1rem;
    }

    .summary-row .lbl { color: #4b5563; }
    .summary-row .val { font-weight: 700; color: #111; }
    .summary-row.discount .val { color: #059669; }
    
    .summary-row.total-row {
        padding-top: 20px;
        margin-top: 12px;
        border-top: 2px dashed #e5e7eb;
    }
    .summary-row.total-row .lbl { font-weight: 800; font-size: 1.1rem; color: #111; }
    .summary-row.total-row .val { font-size: 1.5rem; font-weight: 900; color: #111; }

    .coupon-box {
        background: #fafafa;
        padding: 16px;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        margin-bottom: 24px;
    }

    .coupon-box .input-group {
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border-radius: 12px;
        overflow: hidden;
    }
    .coupon-box .form-control {
        border: none;
        padding: 12px 16px;
        font-weight: 600;
    }
    .coupon-box .form-control:focus {
        box-shadow: none;
    }

    .btn-place-order {
        width: 100%;
        padding: 18px;
        background: #111;
        color: #fff;
        border: none;
        border-radius: 16px;
        font-size: 1.1rem;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        margin-top: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-place-order:hover {
        background: #000;
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(17,17,17,0.25);
    }
    .btn-place-order:active {
        transform: translateY(0);
    }
</style>

<div class="checkout-page">
    <h1 class="checkout-title">Checkout</h1>
    <p class="checkout-subtitle">Review details, select address, and place order.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            ⚠️ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["CouponSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            ✅ @TempData["CouponSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="PlaceOrder" method="post" id="placeOrderForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@Model.UserId" />
        <input type="hidden" name="couponCode" value="@Model.CouponCode" />

        <div class="row">
            <!-- Form Details -->
            <div class="col-lg-8 col-12 mb-4">
                <!-- Address Section -->
                <div class="checkout-card mb-4">
                    <h3 class="checkout-card-title">
                        <span class="step-num">1</span> Shipping Address Selection
                    </h3>
                    
                    @if (addresses.Any())
                    {
                        <div class="address-cards">
                            @foreach (var addr in addresses)
                            {
                                <label class="address-card @(addr.IsDefault ? "selected" : "")" id="addr-card-@addr.AddressId">
                                    <input type="radio" name="addressId" value="@addr.AddressId" @(addr.IsDefault ? "checked" : "") onchange="selectAddressCard(@addr.AddressId)" required />
                                    <span class="address-type-badge">@addr.AddressType</span>
                                    <div class="address-name">@addr.ReceiverName</div>
                                    <div class="address-phone"><i class="fas fa-phone-alt text-muted me-1"></i> @addr.ReceiverPhone</div>
                                    <div class="address-detail">@addr.StreetAddress, @addr.Ward, @addr.District, @addr.Province</div>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0 border-0 rounded-3">
                            <i class="fas fa-exclamation-triangle me-1"></i> No addresses found in your address book. Please add an address to continue.
                        </div>
                    }
                </div>

                <!-- Customer Note Section -->
                <div class="checkout-card mb-4">
                    <h3 class="checkout-card-title">
                        <span class="step-num">2</span> Note for Seller <span class="text-muted fw-normal fs-6 ms-2">(Optional)</span>
                    </h3>
                    <div class="note-section">
                        <textarea name="customerNote" rows="3" placeholder="Enter special instructions (e.g. deliver during office hours, call before delivery)..."></textarea>
                    </div>
                </div>

                <!-- Payment Selection Section -->
                <div class="checkout-card mb-0">
                    <h3 class="checkout-card-title">
                        <span class="step-num">3</span> Payment Selection
                    </h3>
                    <div class="payment-method-selector">
                        <!-- COD -->
                        <label class="method-card selected" id="method-card-cod">
                            <input type="radio" name="paymentMethod" value="COD" checked onchange="selectPaymentMethod('COD')" required />
                            <span class="icon">💵</span>
                            <h4>Cash on Delivery</h4>
                        </label>
                        <!-- VNPay -->
                        <label class="method-card" id="method-card-vnpay">
                            <input type="radio" name="paymentMethod" value="VNPay" onchange="selectPaymentMethod('VNPay')" required />
                            <span class="icon">💳</span>
                            <h4>VNPay Online</h4>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Sidebar Order Summary -->
            <div class="col-lg-4 col-12">
                <div class="checkout-summary">
                    <h3>Order Details</h3>

                    <!-- Cart items list -->
                    <div class="mb-4">
                        @foreach (var item in Model.Items)
                        {
                            <div class="checkout-item">
                                <span class="name">@item.ProductName <span class="text-muted ms-1">x@item.Quantity</span></span>
                                <span class="price">@item.Subtotal.ToString("C")</span>
                            </div>
                        }
                    </div>

                    <!-- Coupon Input Box -->
                    <div class="coupon-box">
                        <label class="form-label fw-bold small text-muted text-uppercase mb-2" style="letter-spacing: 0.5px;">Coupon Code</label>
                        <div class="input-group">
                            <input type="text" id="checkoutCouponCode" class="form-control" placeholder="Enter coupon code" value="@Model.CouponCode" />
                            @if (!string.IsNullOrEmpty(Model.CouponCode))
                            {
                                <button type="button" class="btn btn-danger px-3" onclick="applyCheckoutCoupon('')"><i class="fas fa-times"></i></button>
                            }
                            <button type="button" class="btn btn-dark px-4" onclick="applyCheckoutCoupon(document.getElementById('checkoutCouponCode').value.trim())">Apply</button>
                        </div>
                    </div>

                    <div class="summary-row">
                        <span class="lbl">Subtotal</span>
                        <span class="val">@Model.SubtotalAmount.ToString("C")</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="summary-row discount">
                            <span class="lbl">Coupon Discount</span>
                            <span class="val">−@Model.DiscountAmount.ToString("C")</span>
                        </div>
                    }

                    <div class="summary-row">
                        <span class="lbl">Shipping Fee</span>
                        <span class="val">
                            @if (Model.ShippingFee == 0)
                            {
                                <span style="color:#16a34a;">FREE</span>
                            }
                            else
                            {
                                @Model.ShippingFee.ToString("C")
                            }
                        </span>
                    </div>

                    <div class="summary-row total-row">
                        <span class="lbl">Total</span>
                        <span class="val">@Model.FinalAmount.ToString("C")</span>
                    </div>

                    <button type="submit" class="btn-place-order" id="submitBtn">
                        Confirm COD Order <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function selectAddressCard(addressId) {
        document.querySelectorAll('.address-card').forEach(function(card) {
            card.classList.remove('selected');
        });
        var card = document.getElementById('addr-card-' + addressId);
        if (card) {
            card.classList.add('selected');
        }
    }

    function selectPaymentMethod(method) {
        document.getElementById('method-card-cod').classList.remove('selected');
        document.getElementById('method-card-vnpay').classList.remove('selected');

        var submitBtn = document.getElementById('submitBtn');
        if (method === 'COD') {
            document.getElementById('method-card-cod').classList.add('selected');
            submitBtn.innerHTML = 'Confirm COD Order <i class="fas fa-arrow-right"></i>';
        } else {
            document.getElementById('method-card-vnpay').classList.add('selected');
            submitBtn.innerHTML = 'Pay with VNPay <i class="fas fa-arrow-right"></i>';
        }
    }

    function applyCheckoutCoupon(code) {
        var userId = document.querySelector('input[name="userId"]').value;
        window.location.href = '/Cart/Checkout?userId=' + userId + '&couponCode=' + encodeURIComponent(code);
    }

    document.addEventListener("DOMContentLoaded", function() {
        var form = document.getElementById("placeOrderForm");
        form.addEventListener("submit", function() {
            var btn = document.getElementById("submitBtn");
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...';
        });
    });
</script>
