@model SHOP.CO.MVC.Models.CartViewModel

@{
    ViewData["Title"] = "Checkout - SHOP.CO";
    var addresses = ViewBag.Addresses as List<SHOP.CO.MVC.Models.UserAddressViewModel> ?? new List<SHOP.CO.MVC.Models.UserAddressViewModel>();
}

<style>
    .checkout-page {
        padding: 48px 80px 80px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .checkout-title {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin-bottom: 8px;
    }

    .checkout-subtitle {
        color: #6b7280;
        font-size: 0.95rem;
        margin-bottom: 36px;
    }

    /* Address Cards */
    .address-cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        margin-bottom: 24px;
    }

    @@media (min-width: 768px) {
        .address-cards {
            grid-template-columns: 1fr 1fr;
        }
    }

    .address-card {
        border: 1.5px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        cursor: pointer;
        position: relative;
        transition: all 0.2s ease;
        background: #fff;
    }

    .address-card:hover {
        border-color: #111;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .address-card.selected {
        border-color: #111;
        background: #fafafa;
    }

    .address-type-badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 999px;
        margin-bottom: 8px;
        background: #111;
        color: #fff;
    }

    .address-card.selected .address-type-badge {
        background: #111;
        color: #fff;
    }

    .address-card input[type="radio"] {
        position: absolute;
        top: 20px;
        right: 20px;
        accent-color: #111;
    }

    .address-name {
        font-weight: 700;
        font-size: 0.95rem;
        color: #111;
        margin-bottom: 4px;
    }

    .address-phone {
        font-size: 0.85rem;
        color: #4b5563;
        margin-bottom: 8px;
    }

    .address-detail {
        font-size: 0.88rem;
        color: #1f2937;
        line-height: 1.4;
    }

    /* Note input */
    .note-section textarea {
        border-radius: 16px;
        padding: 16px;
        border: 1.5px solid #e5e7eb;
        font-size: 0.9rem;
        width: 100%;
        outline: none;
        resize: vertical;
    }

    .note-section textarea:focus {
        border-color: #111;
    }

    /* Method Selector */
    .payment-method-selector {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 24px;
    }

    .method-card {
        border: 1.5px solid #e5e7eb;
        border-radius: 16px;
        padding: 20px;
        cursor: pointer;
        text-align: center;
        transition: all 0.2s ease;
        background: #fff;
        position: relative;
    }

    .method-card:hover {
        border-color: #111;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    .method-card.selected {
        border-color: #111;
        background: #111;
        color: #fff;
    }

    .method-card input[type="radio"] {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    .method-card .icon {
        font-size: 2rem;
        display: block;
        margin-bottom: 8px;
    }

    .method-card h4 {
        font-size: 0.95rem;
        font-weight: 700;
        margin: 0;
    }

    /* Checkout summary sidebar */
    .checkout-summary {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 28px;
        position: sticky;
        top: 24px;
    }

    .checkout-summary h3 {
        font-size: 1.1rem;
        font-weight: 800;
        margin-bottom: 20px;
        padding-bottom: 14px;
        border-bottom: 1px solid #f0f0f0;
    }

    .checkout-item {
        display: flex;
        justify-content: space-between;
        font-size: 0.88rem;
        margin-bottom: 12px;
        color: #4b5563;
    }

    .checkout-item .name {
        font-weight: 600;
        color: #111;
        max-width: 70%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        font-size: 0.93rem;
    }

    .summary-row .lbl { color: #6b7280; }
    .summary-row .val { font-weight: 700; color: #111; }
    .summary-row.discount .val { color: #16a34a; }
    
    .summary-row.total-row {
        padding-top: 16px;
        margin-top: 8px;
        border-top: 2px solid #111;
    }
    .summary-row.total-row .lbl { font-weight: 800; font-size: 1rem; color: #111; }
    .summary-row.total-row .val { font-size: 1.25rem; font-weight: 900; color: #111; }

    .btn-place-order {
        width: 100%;
        padding: 16px;
        background: #111;
        color: #fff;
        border: none;
        border-radius: 999px;
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 20px;
    }

    .btn-place-order:hover {
        background: #374151;
    }
</style>

<div class="checkout-page">
    <h1 class="checkout-title">Checkout</h1>
    <p class="checkout-subtitle">Review details, select address, and place order.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            ⚠️ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="PlaceOrder" method="post" id="placeOrderForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@Model.UserId" />
        <input type="hidden" name="couponCode" value="@Model.CouponCode" />

        <div class="row">
            <!-- Form Details -->
            <div class="col-lg-8 col-12 mb-4">
                <!-- Address Section -->
                <div class="card border-0 rounded-4 shadow-sm bg-light p-4 mb-4">
                    <h3 class="h5 fw-bold mb-3 border-bottom pb-2">1. Shipping Address Selection</h3>
                    
                    @if (addresses.Any())
                    {
                        <div class="address-cards">
                            @foreach (var addr in addresses)
                            {
                                <label class="address-card @(addr.IsDefault ? "selected" : "")" id="addr-card-@addr.AddressId">
                                    <input type="radio" name="addressId" value="@addr.AddressId" @(addr.IsDefault ? "checked" : "") onchange="selectAddressCard(@addr.AddressId)" required />
                                    <span class="address-type-badge">@addr.AddressType</span>
                                    <div class="address-name">@addr.ReceiverName</div>
                                    <div class="address-phone">📞 @addr.ReceiverPhone</div>
                                    <div class="address-detail">@addr.StreetAddress, @addr.Ward, @addr.District, @addr.Province</div>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            ⚠️ No addresses found in your address book. Please add an address to continue.
                        </div>
                    }
                </div>

                <!-- Customer Note Section -->
                <div class="card border-0 rounded-4 shadow-sm bg-light p-4 mb-4">
                    <h3 class="h5 fw-bold mb-3 border-bottom pb-2">2. Note for Seller (Optional)</h3>
                    <div class="note-section">
                        <textarea name="customerNote" rows="3" placeholder="Enter special instructions (e.g. deliver during office hours, call before delivery)..."></textarea>
                    </div>
                </div>

                <!-- Payment Selection Section -->
                <div class="card border-0 rounded-4 shadow-sm bg-light p-4 mb-0">
                    <h3 class="h5 fw-bold mb-3 border-bottom pb-2">3. Payment Selection</h3>
                    <div class="payment-method-selector">
                        <!-- COD -->
                        <label class="method-card selected" id="method-card-cod">
                            <input type="radio" name="paymentMethod" value="COD" checked onchange="selectPaymentMethod('COD')" required />
                            <span class="icon">💵</span>
                            <h4>Cash on Delivery</h4>
                        </label>
                        <!-- VNPay -->
                        <label class="method-card" id="method-card-vnpay">
                            <input type="radio" name="paymentMethod" value="VNPay" onchange="selectPaymentMethod('VNPay')" required />
                            <span class="icon">💳</span>
                            <h4>VNPay Online</h4>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Sidebar Order Summary -->
            <div class="col-lg-4 col-12">
                <div class="checkout-summary">
                    <h3>Order Details</h3>

                    <!-- Cart items list -->
                    <div class="mb-4">
                        @foreach (var item in Model.Items)
                        {
                            <div class="checkout-item">
                                <span class="name">@item.ProductName (x@item.Quantity)</span>
                                <strong>@item.Subtotal.ToString("C")</strong>
                            </div>
                        }
                    </div>

                    <hr />

                    <div class="summary-row">
                        <span class="lbl">Subtotal</span>
                        <span class="val">@Model.SubtotalAmount.ToString("C")</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="summary-row discount">
                            <span class="lbl">Coupon Discount</span>
                            <span class="val">−@Model.DiscountAmount.ToString("C")</span>
                        </div>
                    }

                    <div class="summary-row">
                        <span class="lbl">Shipping Fee</span>
                        <span class="val">
                            @if (Model.ShippingFee == 0)
                            {
                                <span style="color:#16a34a;">FREE</span>
                            }
                            else
                            {
                                @Model.ShippingFee.ToString("C")
                            }
                        </span>
                    </div>

                    <div class="summary-row total-row">
                        <span class="lbl">Total</span>
                        <span class="val">@Model.FinalAmount.ToString("C")</span>
                    </div>

                    <button type="submit" class="btn-place-order" id="submitBtn">
                        Confirm COD Order →
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    function selectAddressCard(addressId) {
        document.querySelectorAll('.address-card').forEach(function(card) {
            card.classList.remove('selected');
        });
        var card = document.getElementById('addr-card-' + addressId);
        if (card) {
            card.classList.add('selected');
        }
    }

    function selectPaymentMethod(method) {
        document.getElementById('method-card-cod').classList.remove('selected');
        document.getElementById('method-card-vnpay').classList.remove('selected');

        var submitBtn = document.getElementById('submitBtn');
        if (method === 'COD') {
            document.getElementById('method-card-cod').classList.add('selected');
            submitBtn.textContent = 'Confirm COD Order →';
        } else {
            document.getElementById('method-card-vnpay').classList.add('selected');
            submitBtn.textContent = 'Pay with VNPay →';
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        var form = document.getElementById("placeOrderForm");
        form.addEventListener("submit", function() {
            var btn = document.getElementById("submitBtn");
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...';
        });
    });
</script>
