@model dynamic
@{
    ViewData["Title"] = "Verify OTP";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh; background: #fafafa;">
    <div class="card shadow-lg border-0 rounded-4 p-5 text-center" style="max-width: 450px; width: 100%; background: #ffffff;">
        <div class="mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-dark text-white rounded-circle" style="width: 64px; height: 64px; font-size: 24px;">
                <i class="fas fa-lock"></i>
            </div>
        </div>
        <h2 class="mb-2 fw-bold" style="letter-spacing: -0.5px;">Xác thực OTP</h2>
        <p class="text-muted mb-4" style="font-size: 0.95rem;">
            Vui lòng nhập mã OTP 6 số được gửi đến email của bạn để hoàn tất đơn hàng.
        </p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger border-0 rounded-3 small text-start">
                <i class="fas fa-exclamation-circle me-1"></i> @TempData["Error"]
            </div>
        }
        @if (TempData["OtpInfo"] != null)
        {
            <div class="alert alert-success border-0 rounded-3 small text-start">
                <i class="fas fa-check-circle me-1"></i> @TempData["OtpInfo"]
            </div>
        }

        <form asp-controller="Cart" asp-action="ConfirmOrder" method="post" id="otpForm">
            <input type="hidden" name="userId" value="@ViewBag.UserId" />
            <div class="mb-4 text-start">
                <label class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 1px;">Mã OTP</label>
                <input type="text" name="otpCode" class="form-control form-control-lg text-center fw-bold" 
                       placeholder="• • • • • •" maxlength="6" pattern="\d{6}" required
                       style="letter-spacing: 0.5em; font-size: 1.5rem; border-radius: 12px; border: 2px solid #e5e7eb; transition: all 0.3s;"
                       onfocus="this.style.borderColor='#111'; this.style.boxShadow='0 0 0 0.25rem rgba(17, 17, 17, 0.1)';"
                       onblur="this.style.borderColor='#e5e7eb'; this.style.boxShadow='none';" />
            </div>
            
            <button type="submit" class="btn btn-dark btn-lg w-100 rounded-pill mb-3" id="confirmOtpBtn" style="font-weight: 700; font-size: 1rem; transition: transform 0.2s;">
                Xác Nhận Đơn Hàng
            </button>
        </form>
        
        <div class="text-muted small">
            Không nhận được mã? <a href="/Cart/Checkout" class="text-dark fw-bold text-decoration-underline">Quay lại và thử lại</a>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var form = document.getElementById("otpForm");
        form.addEventListener("submit", function() {
            var btn = document.getElementById("confirmOtpBtn");
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...';
            btn.style.transform = 'scale(0.98)';
        });
    });
</script>
