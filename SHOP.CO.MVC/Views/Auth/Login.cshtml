@model SHOP.CO.MVC.Models.LoginVM
@{
    ViewData["Title"] = "Đăng Nhập";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow border-0 rounded-3">
                <div class="card-body p-4 p-md-5">
                    <h3 class="text-center mb-4 fw-bold">Đăng Nhập</h3>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success py-2">@TempData["SuccessMessage"]</div>
                    }

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger py-2">@ViewBag.ErrorMessage</div>
                    }

                    <form id="loginForm">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Email</label>
                            <input id="email" type="email" class="form-control"
                             placeholder="shopco@example.com" required
                             oninvalid="this.setCustomValidity('Vui lòng nhập email')"
                             oninput="this.setCustomValidity('')" />
                         </div>
                        <div class="mb-4">
                            <label class="form-label text-muted small">Mật khẩu</label>
                            <input id="password" type="password" class="form-control" placeholder="••••••••" required
                             oninvalid="this.setCustomValidity('Vui lòng nhập mật khẩu')"
                             oninput="this.setCustomValidity('')" />
                         </div>
                         <button type="submit" id="btnLogin" class="btn btn-dark w-100 py-2 mb-3">ĐĂNG NHẬP</button>
                    </form>

                    <div class="d-flex justify-content-between small">
                        <a href="/Auth/Register" class="text-decoration-none text-primary">Tạo tài khoản mới</a>
                        <a href="/Auth/ForgotPassword" class="text-decoration-none text-danger">Quên mật khẩu?</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $('#loginForm').submit(function(e) {
            e.preventDefault();
            
            if (!this.checkValidity()) {
                this.reportValidity();
                return;
            }

            let data = {
                Email: $('#email').val(),
                Password: $('#password').val()
            };

            $('#btnLogin').html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...').prop('disabled', true);

            $.ajax({
                url: '/Auth/Login', // Post to MVC Controller
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(res) {
                    $('#btnLogin').html('ĐĂNG NHẬP').prop('disabled', false);
                    if(res.isSuccess) {
                        window.location.href = res.redirectUrl;
                    } else {
                        // Backend validation format (like Vui lòng nhập Email!<br/>The Password field is required.)
                        let errorMessage = res.message.replace(/<br\/>/g, '<br>');
                        Swal.fire('Lỗi đăng nhập', errorMessage, 'error');
                    }
                },
                error: function(xhr) {
                    $('#btnLogin').html('ĐĂNG NHẬP').prop('disabled', false);
                    Swal.fire('Lỗi', 'Có lỗi xảy ra, vui lòng thử lại sau!', 'error');
                }
            });
        });
    </script>
}
