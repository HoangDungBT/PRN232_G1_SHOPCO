@{
    ViewData["Title"] = "Quên Mật Khẩu";
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-body p-5">

                    <!-- BƯỚC 1: NHẬP EMAIL -->
                    <div id="stepEmail">
                        <h3 class="text-center font-weight-light mb-2 text-danger fw-bold"><i class="fas fa-lock me-2"></i>QUÊN MẬT KHẨU</h3>
                        <p class="text-muted text-center small mb-4">Nhập email đăng ký, chúng tôi sẽ gửi mã OTP để đặt lại mật khẩu.</p>

                        <form id="emailForm">
                            <div class="form-floating mb-3">
                                <input class="form-control" id="email" type="email"
                                 placeholder="name@example.com" required 
                                 oninvalid="this.setCustomValidity('Vui lòng nhập email')"
                                 oninput="this.setCustomValidity('')"/>
                                <label for="email">Địa chỉ Email</label>
                            </div>
                            <div class="d-grid mt-4 mb-0">
                                <button class="btn btn-danger btn-block py-2 fw-bold" type="submit" id="btnSendOtp">GỬI MÃ KHÔI PHỤC</button>
                            </div>
                        </form>
                        <div class="text-center mt-3">
                            <div class="small"><a href="/Auth/Login">Trở về Đăng nhập</a></div>
                        </div>
                    </div>

                    <!-- BƯỚC 2: NHẬP OTP VÀ MẬT KHẨU MỚI -->
                    <div id="stepReset" class="d-none">
                        <h4 class="text-center font-weight-light mb-4 text-primary fw-bold">ĐẶT LẠI MẬT KHẨU</h4>
                        <p class="text-muted text-center small">Mã OTP đã được gửi đến <strong id="sentEmailTxt"></strong></p>

                        <form id="resetForm">
                            <div class="form-floating mb-3">
                                <input class="form-control fw-bold letter-spacing-5 text-center" id="otpCode" type="text" placeholder="------" maxlength="6" required />
                                <label for="otpCode">Mã OTP 6 số</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input class="form-control" id="newPassword" type="password" placeholder="Mật khẩu mới" required minlength="6" />
                                <label for="newPassword">Mật khẩu mới</label>
                            </div>
                            <div class="d-grid mt-4 mb-0">
                                <button class="btn btn-success btn-block py-2 fw-bold" type="submit" id="btnReset">ĐỔI MẬT KHẨU</button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="apiBaseUrl" value="@ViewBag.ApiBaseUrl" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const apiUrl = $('#apiBaseUrl').val();
        let targetEmail = "";

        // 1. GỬI YÊU CẦU LẤY OTP
        $('#emailForm').submit(function(e) {
            e.preventDefault();
            targetEmail = $('#email').val();

            $('#btnSendOtp').html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...').prop('disabled', true);

            $.ajax({
                url: apiUrl + 'api/auth/forgot-password',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ email: targetEmail }),
                success: function(res) {
                    if(res.isSuccess) {
                        $('#sentEmailTxt').text(targetEmail);
                        $('#stepEmail').addClass('d-none');
                        $('#stepReset').removeClass('d-none').hide().fadeIn();
                    }
                },
                error: function(xhr) {
                    $('#btnSendOtp').html('GỬI MÃ KHÔI PHỤC').prop('disabled', false);
                    let err = xhr.responseJSON ? xhr.responseJSON.message : "Có lỗi xảy ra!";
                    Swal.fire('Lỗi', err, 'error');
                }
            });
        });

        // 2. GỬI MẬT KHẨU MỚI KÈM OTP
        $('#resetForm').submit(function(e) {
            e.preventDefault();
            let data = {
                email: targetEmail,
                otpCode: $('#otpCode').val(),
                newPassword: $('#newPassword').val()
            };

            let verifyUrl = apiUrl.endsWith('/') ? `${apiUrl}api/auth/reset-password` : `${apiUrl}/api/auth/reset-password`;
            $('#btnReset').html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...').prop('disabled', true);

            $.ajax({
                url: verifyUrl,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(res) {
                    if(res.isSuccess) {
                        Swal.fire('Thành công!', res.message, 'success').then(() => {
                            window.location.href = '/Auth/Login';
                        });
                    }
                },
                error: function(xhr) {
                    $('#btnReset').html('ĐỔI MẬT KHẨU').prop('disabled', false);
                    let err = xhr.responseJSON ? xhr.responseJSON.message : "Mã OTP không đúng hoặc đã hết hạn!";
                    Swal.fire('Lỗi', err, 'error');
                }
            });
        });
    </script>
}