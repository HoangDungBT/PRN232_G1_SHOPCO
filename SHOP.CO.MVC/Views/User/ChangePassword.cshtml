@model SHOP.CO.MVC.Models.ChangePasswordViewModel

<div class="page-wrapper">
    <h1 class="page-title">Đổi mật khẩu</h1>
    <div class="custom-card" style="max-width: 500px; margin: 0 auto;">
        <form asp-action="ChangePassword" method="post">
            <div class="form-group">
                <label class="form-label">Mật khẩu hiện tại</label>
                <input asp-for="CurrentPassword" type="password" class="form-control" />
                <span asp-validation-for="CurrentPassword" class="text-danger" style="color:red; font-size:13px;"></span>
            </div>
            <div class="form-group">
                <label class="form-label">Mật khẩu mới</label>
                <input asp-for="NewPassword" type="password" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Xác nhận mật khẩu</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger" style="color:red; font-size:13px;"></span>
            </div>
            <button type="submit" class="btn-primary" style="width: 100%;">Cập nhật mật khẩu</button>
        </form>
        <div style="text-align: center; margin-top: 15px;">
            <a asp-action="Profile" style="color: #666; text-decoration: underline; font-size: 14px;">Quay lại hồ sơ</a>
        </div>
    </div>
</div>