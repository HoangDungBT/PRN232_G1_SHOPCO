@model List<SHOP.CO.MVC.Models.OrderHistoryViewModel>

<div class="page-wrapper">
    <h1 class="page-title">Lịch sử đơn hàng</h1>

    <div style="display: flex; flex-direction: column; gap: 15px;">
        @if (!Model.Any())
        {
            <div class="custom-card" style="text-align:center; color:#888;">Bạn chưa có đơn hàng nào.</div>
        }
        else
        {
            @foreach (var order in Model)
            {
                <div class="item-card custom-card" style="display: flex; flex-direction: row; justify-content: space-between; align-items: center; flex-wrap: wrap;">
                    <div>
                        <h4 style="margin: 0 0 5px 0;">Mã: #@order.OrderCode</h4>
                        <small style="color: #888;">@order.CreatedAt</small>
                    </div>
                    <div style="text-align: right;">
                        <div class="badge-status" style="background:#f3f3f3; border:1px solid #ddd;">@order.OrderStatus</div>
                        <h3 style="margin: 5px 0 0 0;">$@order.TotalAmount</h3>
                    </div>
                    <div style="width: 100%; border-top: 1px solid #eee; padding-top: 10px; margin-top: 10px; text-align: right;">
                        <a asp-action="Detail" asp-route-id="@order.OrderId" class="btn-secondary" style="padding: 6px 20px; font-size: 14px;">Xem chi tiết</a>
                    </div>
                </div>
            }
        }
    </div>
</div>