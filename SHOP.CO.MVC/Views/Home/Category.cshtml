@model List<SHOP.CO.MVC.Models.ProductVM>

<div class="category-container">
    <!-- BREADCRUMB -->
    <div class="breadcrumb-trail">
        <a href="/">Home</a> <span>&gt;</span> <span class="current-crumb">Casual</span>
    </div>

    <div class="category-layout">
        <!-- SIDEBAR FILTER FORM -->
        <aside class="sidebar-filter">
            <div class="filter-header">
                <h2>Filters</h2>
                <span class="filter-toggle-icon">🎛️</span>
            </div>

            <form id="filterForm" method="get" action="/Home/Category" onsubmit="return validatePriceFilter()">
                <!-- Hidden inputs for state management -->
                <input type="hidden" name="categoryId" id="hiddenCategoryId" value="@ViewBag.CategoryId" />
                <input type="hidden" name="color" id="hiddenColor" value="@ViewBag.Color" />
                <input type="hidden" name="size" id="hiddenSize" value="@ViewBag.Size" />
                <input type="hidden" name="brand" id="hiddenBrand" value="@ViewBag.Brand" />
                <input type="hidden" name="sortOrder" id="hiddenSortOrder" value="@ViewBag.SortOrder" />
                <input type="hidden" name="page" id="hiddenPage" value="@ViewBag.CurrentPage" />

                <!-- Categories Accordion -->
                <div class="filter-section">
                    <ul class="category-filter-list">
                        @if (ViewBag.Categories != null && ((List<SHOP.CO.Application.DTOs.CategoryDto>)ViewBag.Categories).Any())
                        {
                            foreach (var cat in (List<SHOP.CO.Application.DTOs.CategoryDto>)ViewBag.Categories)
                            {
                                <li>
                                    <a href="javascript:void(0)" class="category-link @(ViewBag.CategoryId == cat.CategoryId ? "active" : "")" data-id="@cat.CategoryId">@cat.CategoryName <span class="arrow">&gt;</span></a>
                                </li>
                            }
                        }
                        else
                        {
                            <li>
                                <a href="javascript:void(0)" class="category-link @(ViewBag.CategoryId == 4 ? "active" : "")" data-id="4">T-shirts <span class="arrow">&gt;</span></a>
                            </li>
                            <li>
                                <a href="javascript:void(0)" class="category-link @(ViewBag.CategoryId == 5 ? "active" : "")" data-id="5">Jeans <span class="arrow">&gt;</span></a>
                            </li>
                            <li>
                                <a href="javascript:void(0)" class="category-link @(ViewBag.CategoryId == 6 ? "active" : "")" data-id="6">Dresses <span class="arrow">&gt;</span></a>
                            </li>
                            <li>
                                <a href="javascript:void(0)" class="category-link @(ViewBag.CategoryId == 7 ? "active" : "")" data-id="7">Shirts <span class="arrow">&gt;</span></a>
                            </li>
                            <li>
                                <a href="javascript:void(0)" class="category-link @(ViewBag.CategoryId == 3 ? "active" : "")" data-id="3">Unisex <span class="arrow">&gt;</span></a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Price Filter -->
                <div class="filter-section">
                    <div class="section-title">
                        <h3>Giá (VNĐ)</h3>
                        <span class="toggle-arrow">▲</span>
                    </div>
                    <div class="price-slider-container">
                        <div class="price-inputs">
                            <div class="price-input-box">
                                <input type="number" id="minPriceInput" name="minPrice" min="0" max="1000000" step="10000" value="@ViewBag.MinPrice" placeholder="VD: 100000" style="width: 100%; padding-right: 4px;" oninput="clearPriceError()" />
                                <span class="currency" style="position: static; font-size: 12px; color: #666;">đ</span>
                            </div>
                            <span class="price-separator">-</span>
                            <div class="price-input-box">
                                <input type="number" id="maxPriceInput" name="maxPrice" min="0" max="1000000" step="10000" value="@ViewBag.MaxPrice" placeholder="VD: 500000" style="width: 100%; padding-right: 4px;" oninput="clearPriceError()" />
                                <span class="currency" style="position: static; font-size: 12px; color: #666;">đ</span>
                            </div>
                        </div>
                        <!-- Validator message -->
                        <div id="priceErrorMsg" style="display:none; color: #e53e3e; font-size: 12px; margin-top: 6px; font-weight: 500;">⚠️ Giá tối thiểu không được lớn hơn giá tối đa!</div>
                        <div style="display: flex; justify-content: space-between; font-size: 11px; color: #999; margin-top: 6px;">
                            <span>120.000đ</span>
                            <span>850.000đ</span>
                        </div>
                    </div>
                </div>

                <!-- Colors Filter -->
                <div class="filter-section">
                    <div class="section-title">
                        <h3>Màu sắc</h3>
                        <span class="toggle-arrow">▲</span>
                    </div>
                    <div class="color-grid">
                        <!-- Màu sắc khớp với DB (tiếng Việt) -->
                        <div class="color-option @(ViewBag.Color == "Đen" ? "selected" : "")" style="background-color: #000000;" data-color="Đen" title="Đen"></div>
                        <div class="color-option @(ViewBag.Color == "Trắng" ? "selected" : "")" style="background-color: #FFFFFF; border: 1px solid #E0E0E0;" data-color="Trắng" title="Trắng"></div>
                        <div class="color-option @(ViewBag.Color == "Đỏ" ? "selected" : "")" style="background-color: #FF0000;" data-color="Đỏ" title="Đỏ"></div>
                        <div class="color-option @(ViewBag.Color == "Xám" ? "selected" : "")" style="background-color: #808080;" data-color="Xám" title="Xám"></div>
                        <div class="color-option @(ViewBag.Color == "Hồng" ? "selected" : "")" style="background-color: #FFB6C1;" data-color="Hồng" title="Hồng"></div>
                        <div class="color-option @(ViewBag.Color == "Xanh Nhạt" ? "selected" : "")" style="background-color: #ADD8E6;" data-color="Xanh Nhạt" title="Xanh Nhạt"></div>
                        <div class="color-option @(ViewBag.Color == "Xanh Denim" ? "selected" : "")" style="background-color: #1560BD;" data-color="Xanh Denim" title="Xanh Denim"></div>
                        <div class="color-option @(ViewBag.Color == "Xanh Đậm" ? "selected" : "")" style="background-color: #00008B;" data-color="Xanh Đậm" title="Xanh Đậm"></div>
                        <div class="color-option @(ViewBag.Color == "Be" ? "selected" : "")" style="background-color: #F5F5DC; border: 1px solid #E0E0E0;" data-color="Be" title="Be"></div>
                    </div>
                </div>

                <!-- Sizes Filter -->
                <div class="filter-section">
                    <div class="section-title">
                        <h3>Kích cỡ</h3>
                        <span class="toggle-arrow">▲</span>
                    </div>
                    <div class="size-pill-grid">
                        <div class="size-pill @(ViewBag.Size == "S" ? "selected" : "")" data-size="S">S</div>
                        <div class="size-pill @(ViewBag.Size == "M" ? "selected" : "")" data-size="M">M</div>
                        <div class="size-pill @(ViewBag.Size == "L" ? "selected" : "")" data-size="L">L</div>
                        <div class="size-pill @(ViewBag.Size == "XL" ? "selected" : "")" data-size="XL">XL</div>
                        <div class="size-pill @(ViewBag.Size == "38" ? "selected" : "")" data-size="38">38</div>
                        <div class="size-pill @(ViewBag.Size == "39" ? "selected" : "")" data-size="39">39</div>
                        <div class="size-pill @(ViewBag.Size == "40" ? "selected" : "")" data-size="40">40</div>
                        <div class="size-pill @(ViewBag.Size == "41" ? "selected" : "")" data-size="41">41</div>
                        <div class="size-pill @(ViewBag.Size == "30" ? "selected" : "")" data-size="30">30</div>
                        <div class="size-pill @(ViewBag.Size == "31" ? "selected" : "")" data-size="31">31</div>
                    </div>
                </div>

                <!-- Dress Style / Brand Filter -->
                <div class="filter-section">
                    <div class="section-title">
                        <h3>Brands</h3>
                        <span class="toggle-arrow">▲</span>
                    </div>
                    <ul class="category-filter-list">
                        <li>
                            <a href="javascript:void(0)" class="brand-link @(ViewBag.Brand == "Shop.Co" ? "active" : "")" data-brand="Shop.Co">Shop.Co <span class="arrow">&gt;</span></a>
                        </li>
                        <li>
                            <a href="javascript:void(0)" class="brand-link @(ViewBag.Brand == "DenimX" ? "active" : "")" data-brand="DenimX">DenimX <span class="arrow">&gt;</span></a>
                        </li>
                        <li>
                            <a href="javascript:void(0)" class="brand-link @(ViewBag.Brand == "OfficeWear" ? "active" : "")" data-brand="OfficeWear">OfficeWear <span class="arrow">&gt;</span></a>
                        </li>
                    </ul>
                </div>

                <!-- Apply Button -->
                <button type="submit" class="apply-filter-btn">Apply Filter</button>
                <a href="/Home/Category" class="clear-filter-link">Reset Filters</a>
            </form>
        </aside>

        <!-- PRODUCT GRID & CONTROLS -->
        <main class="products-main">
            <!-- Header Controls -->
            <div class="products-header">
                <h2>Casual</h2>
                <div class="header-right">
                    <span class="results-count">Showing 1-@Model.Count of @ViewBag.TotalCount Products</span>
                    <div class="sort-dropdown-container">
                        <label for="sortSelector">Sort by:</label>
                        <select id="sortSelector" onchange="updateSortOrder(this.value)">
                            <option value="" selected="@(string.IsNullOrEmpty(ViewBag.SortOrder) ? "selected" : null)">Default</option>
                            <option value="price_asc" selected="@(ViewBag.SortOrder == "price_asc" ? "selected" : null)">Price: Low to High</option>
                            <option value="price_desc" selected="@(ViewBag.SortOrder == "price_desc" ? "selected" : null)">Price: High to Low</option>
                            <option value="newest" selected="@(ViewBag.SortOrder == "newest" ? "selected" : null)">Newest</option>
                            <option value="popular" selected="@(ViewBag.SortOrder == "popular" ? "selected" : null)">Most Popular</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Product Grid -->
            <div class="product-grid">
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var displayRating = item.ReviewCount > 0 ? item.AverageRating : 0m;
                        var roundedRating = (int)Math.Round(displayRating);

                        var hasDiscount = item.SalePrice.HasValue && item.SalePrice < item.BasePrice;
                        var discountPercent = hasDiscount ? (int)Math.Round((1 - (item.SalePrice!.Value / item.BasePrice)) * 100) : 0;

                        <div class="product-card" style="position: relative;">
                            <a href="/Home/Detail/@item.Id" class="card-image-link">
                                <div class="card-image-wrapper" style="position: relative;">
                                    <img src="@(string.IsNullOrEmpty(item.Image) ? "/images/heroimg.png" : item.Image)" onerror="this.onerror=null; this.src='/images/heroimg.png';" alt="@item.Name" />
                                </div>
                            </a>
                            @{
                                var wishlistProductIds = ViewBag.WishlistProductIds as HashSet<int> ?? new HashSet<int>();
                                var isInWishlist = wishlistProductIds.Contains(item.Id);
                            }
                            <button type="button" class="btn-wishlist-toggle" onclick="ajaxToggleWishlist(event, @item.Id)" style="position: absolute; top: 12px; right: 12px; border: none; background: #FFFFFF; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.1); cursor: pointer; transition: all 0.2s ease; z-index: 10;" title="Yêu thích">
                                <span class="wishlist-heart-icon" id="heart-@item.Id" style="font-size: 18px; color: @(isInWishlist ? "#FF3333" : "rgba(0,0,0,0.3)"); transition: color 0.2s ease;">♥</span>
                            </button>
                            <div class="card-details">
                                <a href="/Home/Detail/@item.Id" style="text-decoration: none; color: inherit;">
                                    <h3 class="product-name">@item.Name</h3>
                                </a>
                                <div class="rating-row">
                                    <div class="star-rating">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= roundedRating && item.ReviewCount > 0)
                                            {
                                                <span class="star-filled">★</span>
                                            }
                                            else
                                            {
                                                <span class="star-empty">★</span>
                                            }
                                        }
                                    </div>
                                    @if (item.ReviewCount > 0)
                                    {
                                        <span class="rating-score">@displayRating.ToString("F1")/5 (@item.ReviewCount đánh giá)</span>
                                    }
                                    else
                                    {
                                        <span class="rating-score" style="color: #888;">0/5 (0 đánh giá)</span>
                                    }
                                </div>
                                <div class="price-row">
                                    <span class="sale-price">@item.Price.ToString("N0")đ</span>
                                    @if (hasDiscount)
                                    {
                                        <span class="original-price">@item.BasePrice.ToString("N0")đ</span>
                                        <span class="discount-tag">-@discountPercent%</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="grid-column: 1/-1; text-align: center; padding: 100px 0; color: rgba(0,0,0,0.5);">
                        <p style="font-size: 18px; font-weight: 600; margin-bottom: 10px;">No products found</p>
                        <p style="font-size: 14px;">Try clearing filters or adjusting your search parameters.</p>
                    </div>
                }
            </div>

            <!-- PAGINATION -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="pagination-container">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <a href="javascript:void(0)" onclick="navigateToPage(@(ViewBag.CurrentPage - 1))" class="page-nav-btn">&larr; Previous</a>
                    }
                    else
                    {
                        <span class="page-nav-btn disabled">&larr; Previous</span>
                    }

                    <div class="page-numbers">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <a href="javascript:void(0)" onclick="navigateToPage(@i)" class="page-number-link @(ViewBag.CurrentPage == i ? "active" : "")">@i</a>
                        }
                    </div>

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <a href="javascript:void(0)" onclick="navigateToPage(@(ViewBag.CurrentPage + 1))" class="page-nav-btn">Next &rarr;</a>
                    }
                    else
                    {
                        <span class="page-nav-btn disabled">Next &rarr;</span>
                    }
                </div>
            }
        </main>
    </div>
</div>

<!-- FILTER LOGIC SCRIPT -->
<script>
    // Submits the filter form when pagination or category selections occur
    function submitFilters() {
        document.getElementById('filterForm').submit();
    }

    function navigateToPage(pageNum) {
        document.getElementById('hiddenPage').value = pageNum;
        submitFilters();
    }

    function updateSortOrder(sortOrder) {
        document.getElementById('hiddenSortOrder').value = sortOrder;
        submitFilters();
    }

    // Set Category ID
    document.querySelectorAll('.category-link').forEach(link => {
        link.addEventListener('click', function() {
            const catId = this.getAttribute('data-id');
            // Toggle active category
            const currentCatId = document.getElementById('hiddenCategoryId').value;
            if (currentCatId === catId) {
                document.getElementById('hiddenCategoryId').value = "";
            } else {
                document.getElementById('hiddenCategoryId').value = catId;
            }
            submitFilters();
        });
    });

    // Set Brand
    document.querySelectorAll('.brand-link').forEach(link => {
        link.addEventListener('click', function() {
            const brandName = this.getAttribute('data-brand');
            const currentBrand = document.getElementById('hiddenBrand').value;
            if (currentBrand === brandName) {
                document.getElementById('hiddenBrand').value = "";
            } else {
                document.getElementById('hiddenBrand').value = brandName;
            }
            submitFilters();
        });
    });

    // Set Color Option
    document.querySelectorAll('.color-option').forEach(option => {
        option.addEventListener('click', function() {
            const selectedColor = this.getAttribute('data-color');
            const currentColor = document.getElementById('hiddenColor').value;

            document.querySelectorAll('.color-option').forEach(opt => opt.classList.remove('selected'));

            if (currentColor === selectedColor) {
                document.getElementById('hiddenColor').value = "";
            } else {
                document.getElementById('hiddenColor').value = selectedColor;
                this.classList.add('selected');
            }
        });
    });

    // Set Size Option
    document.querySelectorAll('.size-pill').forEach(pill => {
        pill.addEventListener('click', function() {
            const selectedSize = this.getAttribute('data-size');
            const currentSize = document.getElementById('hiddenSize').value;

            document.querySelectorAll('.size-pill').forEach(p => p.classList.remove('selected'));

            if (currentSize === selectedSize) {
                document.getElementById('hiddenSize').value = "";
            } else {
                document.getElementById('hiddenSize').value = selectedSize;
                this.classList.add('selected');
            }
        });
    });

    function ajaxToggleWishlist(event, productId) {
        event.preventDefault();
        event.stopPropagation();

        fetch('/Home/ToggleWishlist/' + productId, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                var heartSpan = document.getElementById('heart-' + productId);
                if (heartSpan) {
                    if (data.isAdded) {
                        heartSpan.style.color = '#FF3333';
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: 'Đã thêm vào yêu thích',
                            showConfirmButton: false,
                            timer: 1500
                        });
                    } else {
                        heartSpan.style.color = 'rgba(0,0,0,0.3)';
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'info',
                            title: 'Đã xóa khỏi yêu thích',
                            showConfirmButton: false,
                            timer: 1500
                        });
                    }
                }
            } else if (data.message === 'unauthorized') {
                Swal.fire({
                    icon: 'warning',
                    title: 'Yêu cầu đăng nhập',
                    text: 'Vui lòng đăng nhập để sử dụng chức năng yêu thích.',
                    showCancelButton: true,
                    confirmButtonColor: '#000',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Đăng nhập ngay',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Auth/Login';
                    }
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: data.message,
                    confirmButtonColor: '#000'
                });
            }
        })
        .catch(error => {
            console.error('Error toggling wishlist:', error);
            alert('Lỗi kết nối máy chủ.');
        });
    }

    // ===== PRICE FILTER VALIDATOR =====
    function validatePriceFilter() {
        const minInput = document.getElementById('minPriceInput');
        const maxInput = document.getElementById('maxPriceInput');
        const errorMsg = document.getElementById('priceErrorMsg');

        const minVal = minInput.value !== '' ? parseFloat(minInput.value) : null;
        const maxVal = maxInput.value !== '' ? parseFloat(maxInput.value) : null;

        // Reset styles
        minInput.style.borderColor = '';
        maxInput.style.borderColor = '';
        errorMsg.style.display = 'none';

        // Fix negative values
        if (minVal !== null && minVal < 0) { minInput.value = 0; return false; }
        if (maxVal !== null && maxVal < 0) { maxInput.value = 0; return false; }

        // Validate: min > max
        if (minVal !== null && maxVal !== null && minVal > maxVal) {
            minInput.style.borderColor = '#e53e3e';
            maxInput.style.borderColor = '#e53e3e';
            errorMsg.style.display = 'block';

            // Shake animation
            [minInput, maxInput].forEach(el => {
                el.style.animation = 'none';
                setTimeout(() => { el.style.animation = 'shake 0.3s ease'; }, 10);
            });
            return false; // Chặn submit
        }

        return true; // Cho phép submit
    }

    function clearPriceError() {
        const errorMsg = document.getElementById('priceErrorMsg');
        const minInput = document.getElementById('minPriceInput');
        const maxInput = document.getElementById('maxPriceInput');
        errorMsg.style.display = 'none';
        minInput.style.borderColor = '';
        maxInput.style.borderColor = '';
    }
</script>

<style>
    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-4px); }
        75% { transform: translateX(4px); }
    }
</style>