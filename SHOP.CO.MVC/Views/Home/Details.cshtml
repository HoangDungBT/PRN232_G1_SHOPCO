@model SHOP.CO.MVC.Models.ProductVM

<div class="detail-page">

    <div class="detail-image">

        <img src="@Model.Image" />

    </div>

    <div class="detail-info">

        <h1>@Model.Name</h1>

        <h2>$@Model.Price</h2>

        <p>
            @Model.Description
        </p>

        <a class="btn btn-primary" href="/Cart/AddToCart?id=@Model.Id&name=@Model.Name&price=@Model.Price&image=@Model.Image" style="display: inline-block; padding: 10px 20px; background-color: #000; color: #fff; text-decoration: none; border-radius: 5px;">
            Add To Cart
        </a>

    </div>

</div>