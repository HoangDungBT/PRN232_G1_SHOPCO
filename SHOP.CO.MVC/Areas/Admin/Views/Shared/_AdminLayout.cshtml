<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị SHOP.CO</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Sử dụng FontAwesome cho icon (nếu có mạng) -->
    <link rel="stylesheet" href="[https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css](https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css)" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .sidebar { min-height: 100vh; background-color: #343a40; color: white; }
        .sidebar a { color: #cfd8dc; text-decoration: none; padding: 15px; display: block; border-bottom: 1px solid #4f5962; }
        .sidebar a:hover { background-color: #495057; color: white; }
        .main-content { background-color: #f8f9fa; }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <div class="sidebar flex-column p-0" style="width: 250px;">
            <div class="p-3 text-center fs-4 fw-bold border-bottom">
                SHOP.CO ADMIN
            </div>
            <a href="/Admin/Dashboard"><i class="fas fa-tachometer-alt me-2"></i> Tổng Quan</a>
            <a href="/Admin/Products"><i class="fas fa-box me-2"></i> Quản Lý Sản Phẩm</a>
            <a href="/Admin/Categories"><i class="fas fa-list me-2"></i> Quản Lý Danh mục</a>
            <a href="/Admin/Orders"><i class="fas fa-shopping-cart me-2"></i> Quản Lý Đơn Hàng</a>
            <a href="/Admin/Users"><i class="fas fa-users me-2"></i> Quản Lý Người Dùng</a>
            <a href="/Admin/Inventory"><i class="fas fa-home me-2"></i> Quản Lý Kho</a>
            <a href="/Admin/Vouchers"><i class="fas fa-ticket-alt me-2"></i> Quản Lý Voucher</a>
            <a href="/Admin/InteractLogs"><i class="fas fa-history me-2"></i> Nhật Ký Hoạt Động</a>
            <a href="/" class="text-warning"><i class="fas fa-arrow-left me-2"></i> Về Trang Cửa Hàng</a>
            <a href="/Auth/Logout" class="text-danger"><i class="fas fa-sign-out-alt me-2"></i> Đăng Xuất</a>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1 main-content">
            <!-- Topbar (Optional) -->
            <div class="bg-white shadow-sm p-3 mb-4 d-flex justify-content-between">
                <h5 class="m-0">@ViewData["Title"]</h5>
                <div>
                    <span class="badge bg-primary">Admin/Staff Mode</span>
                </div>
            </div>

            <!-- Page Content -->
            <div class="container-fluid px-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
   
    <script>
        // Cài đặt mặc định cho TẤT CẢ các request AJAX trong trang
        $.ajaxSetup({
            error: function (xhr, textStatus, errorThrown) {
                // Tắt tất cả các spinner đang quay (nếu có)
                $('.fa-spinner').parent().prop('disabled', false).html(function(i, oldHtml) {
                     return oldHtml.replace('<i class="fas fa-spinner fa-spin"></i> ', '').replace(' Đang xử lý...', '');
                });

                let errorMessage = "Không thể kết nối đến máy chủ!";

                // Nếu có phản hồi từ máy chủ (đã được bọc trong ResultModel)
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMessage = xhr.responseJSON.message;
                } else if (xhr.responseText) {
                    // Cứu cánh cuối cùng nếu không parse được JSON
                    try {
                        let parsed = JSON.parse(xhr.responseText);
                        errorMessage = parsed.message || errorMessage;
                    } catch (e) { }
                }

                // Hiển thị lỗi dùng SweetAlert2
                Swal.fire({
                    title: 'Thông báo',
                    html: errorMessage, // Dùng 'html' để nhận các thẻ <br> từ backend
                    icon: 'error'
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
