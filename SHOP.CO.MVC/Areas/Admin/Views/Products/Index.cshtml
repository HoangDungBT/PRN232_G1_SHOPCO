@{
    ViewData["Title"] = "Quản Lý Sản Phẩm ShopCo";
}

<datalist id="brandList"></datalist>
<datalist id="materialList"></datalist>
<datalist id="sizeList"></datalist>
<datalist id="colorList"></datalist>

<div class="card shadow-sm border-0 mt-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold"><i class="fas fa-box text-primary me-2"></i> Danh Sách Sản Phẩm</h5>
        <button class="btn btn-primary btn-sm" onclick="ProductManager.openOffcanvas('create')">
            <i class="fas fa-plus me-1"></i> Thêm Sản Phẩm
        </button>
    </div>
    <div class="card-body">

        <div class="row mb-3 g-2">
            <div class="col-md-3">
                <input type="text" id="searchInput" class="form-control" placeholder="Tên sản phẩm...">
            </div>
            <div class="col-md-2">
                <select id="filterStatus" class="form-select" onchange="ProductManager.resetPageAndLoad()">
                    <option value="all">Tất cả trạng thái</option>
                    <option value="active">Đang mở bán</option>
                    <option value="inactive">Đã dừng bán</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="filterStock" class="form-select" onchange="ProductManager.resetPageAndLoad()">
                    <option value="all">Tất cả tồn kho</option>
                    <option value="lowstock">Sắp hết hàng (!)</option>
                </select>
            </div>
            <div class="col-md-1">
                <button id="btnSearch" class="btn btn-outline-secondary w-100"><i class="fas fa-search"></i> Tìm</button>
            </div>

            <div class="col-md-4 d-flex justify-content-end align-items-center">
                <!-- Nút thao tác hàng loạt (Mặc định ẩn, hiện khi có check) -->
                <div id="bulkActions" class="d-none">
                    <span class="me-2 small text-muted">Đã chọn: <strong id="selectedCount">0</strong></span>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-success" onclick="ProductManager.bulkUpdateStatus(true)" title="Mở bán hàng loạt"><i class="fas fa-play"></i> Mở bán</button>
                        <button type="button" class="btn btn-warning text-dark" onclick="ProductManager.bulkUpdateStatus(false)" title="Dừng bán hàng loạt"><i class="fas fa-pause"></i> Dừng</button>
                        <button type="button" class="btn btn-primary" onclick="ProductManager.bulkUpdateFeatured(true)" title="Đánh dấu nổi bật"><i class="fas fa-star"></i> Nổi bật</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th width="40" class="text-center">
                            <input class="form-check-input" type="checkbox" id="chkSelectAll">
                        </th>
                        <th width="80" class="text-center">Ảnh</th>
                        <th style="cursor: pointer;" onclick="ProductManager.changeSort('ProductName')">Tên Sản Phẩm <i class="fas fa-sort text-muted ms-1 sort-icon" id="sort-ProductName"></i></th>
                        <th style="cursor: pointer;" onclick="ProductManager.changeSort('CategoryName')">Danh Mục <i class="fas fa-sort text-muted ms-1 sort-icon" id="sort-CategoryName"></i></th>
                        <th style="cursor: pointer;" onclick="ProductManager.changeSort('BasePrice')">Giá Gốc <i class="fas fa-sort text-muted ms-1 sort-icon" id="sort-BasePrice"></i></th>
                        <th style="cursor: pointer;" onclick="ProductManager.changeSort('IsActive')">Trạng Thái <i class="fas fa-sort text-muted ms-1 sort-icon" id="sort-IsActive"></i></th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="productTableBody">
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted" id="paginationInfo"></div>
            <nav><ul class="pagination mb-0" id="paginationUl"></ul></nav>
        </div>
    </div>
</div>

<partial name="_ProductOffcanvas" />

<input type="hidden" id="apiBaseUrl" value="@ViewBag.ApiBaseUrl" />
<input type="hidden" id="jwtToken" value="@ViewBag.Token" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin/common.js" asp-append-version="true"></script>
    <script src="~/js/admin/products.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            const apiUrl = $('#apiBaseUrl').val();
            const token = $('#jwtToken').val();
            ProductManager.init(apiUrl, token);
        });
    </script>
}