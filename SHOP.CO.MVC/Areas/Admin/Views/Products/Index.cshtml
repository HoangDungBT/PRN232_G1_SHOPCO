@{
    ViewData["Title"] = "Quản Lý Sản Phẩm ShopCo";
}

<!-- ========================================== -->
<!-- DANH SÁCH DATALIST ĐỂ HIỂN THỊ GỢI Ý ĐỘNG  -->
<!-- ========================================== -->
<datalist id="brandList"></datalist>
<datalist id="materialList"></datalist>
<datalist id="sizeList"></datalist>
<datalist id="colorList"></datalist>

<div class="card shadow-sm border-0 mt-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold"><i class="fas fa-box text-primary me-2"></i> Danh Sách Sản Phẩm</h5>
        <button class="btn btn-primary btn-sm" onclick="openOffcanvas('create')">
            <i class="fas fa-plus me-1"></i> Thêm Sản Phẩm
        </button>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm theo tên sản phẩm...">
            </div>
            <div class="col-md-2">
                <button id="btnSearch" class="btn btn-outline-secondary w-100"><i class="fas fa-search"></i> Tìm</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Tên Sản Phẩm</th>
                        <th>Danh Mục</th>
                        <th>Giá Gốc</th>
                        <th>Trạng Thái</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="productTableBody">
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted" id="paginationInfo"></div>
            <nav><ul class="pagination mb-0" id="paginationUl"></ul></nav>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasProduct" aria-labelledby="offcanvasProductLabel" style="width: 700px;">
    <div class="offcanvas-header bg-light border-bottom">
        <h5 class="offcanvas-title fw-bold" id="offcanvasProductLabel">Thêm Sản Phẩm Mới</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form id="productForm">
            <input type="hidden" id="ProductId" value="0" />

            <h6 class="fw-bold text-primary mb-3"><i class="fas fa-info-circle"></i> Thông Tin Cơ Bản</h6>

            <div class="mb-3">
                <label class="form-label fw-bold">Danh Mục (*)</label>
                <!-- Category vẫn BẮT BUỘC là Select chọn theo ID -->
                <select id="CategoryId" class="form-select" required
                        oninvalid="this.setCustomValidity('Vui lòng chọn một danh mục hợp lệ')"
                        oninput="this.setCustomValidity('')">
                    <option value="">-- Đang tải danh mục... --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Tên Sản Phẩm (*)</label>
                <input type="text" id="ProductName" class="form-control" placeholder="VD: Áo thun nam tay ngắn..." required
                       oninvalid="this.setCustomValidity('Tên sản phẩm không được để trống')"
                       oninput="this.setCustomValidity('')" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Thương Hiệu</label>
                    <!-- Chuyển thành text + datalist -->
                    <input type="text" id="Brand" class="form-control" list="brandList" placeholder="Chọn hoặc nhập mới..." autocomplete="off" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Chất Liệu</label>
                    <!-- Chuyển thành text + datalist -->
                    <input type="text" id="Material" class="form-control" list="materialList" placeholder="Chọn hoặc nhập mới..." autocomplete="off" />
                </div>
            </div>

            <div class="row border p-3 bg-light rounded mx-0 mb-3">
                <div class="col-md-6 mb-3 mb-md-0">
                    <label class="form-label fw-bold text-danger">Giá Gốc (*) VNĐ</label>
                    <input type="number" id="BasePrice" class="form-control border-danger" required min="1000" placeholder="VD: 150000"
                           oninvalid="this.setCustomValidity('Giá gốc phải lớn hơn hoặc bằng 1,000 VNĐ')"
                           oninput="this.setCustomValidity('')" />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-success">Giá Khuyến Mãi (VNĐ)</label>
                    <input type="number" id="SalePrice" class="form-control border-success" min="0" placeholder="Để trống nếu không sale"
                           oninvalid="this.setCustomValidity('Giá khuyến mãi không được là số âm')"
                           oninput="this.setCustomValidity('')" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Mô tả chi tiết</label>
                <textarea id="Description" class="form-control" rows="4" placeholder="Nhập mô tả sản phẩm..."></textarea>
            </div>

            <div class="row mb-4 bg-light p-2 rounded mx-0">
                <div class="col-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="IsActive" checked>
                        <label class="form-check-label fw-bold">Đang Mở Bán (Active)</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="IsFeatured">
                        <label class="form-check-label text-warning fw-bold">Sản Phẩm Nổi Bật</label>
                    </div>
                </div>
            </div>

            <div id="variantsSection">
                <div class="d-flex justify-content-between align-items-center mb-2 mt-4 border-top pt-3">
                    <h6 class="fw-bold text-primary m-0"><i class="fas fa-tags"></i> Phân Loại Hàng (Size/Màu) (*)</h6>
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="addVariantRow()">
                        <i class="fas fa-plus"></i> Thêm Phân Loại
                    </button>
                </div>
                <div id="variantContainer" class="mb-3">
                </div>
                <small class="text-danger d-block mb-3" id="variantWarningTxt">
                    * Lưu ý: Hiện tại Backend chỉ hỗ trợ thêm mới biến thể. Cập nhật biến thể sẽ được mở rộng trong tương lai.
                </small>
            </div>

        </form>
    </div>
    <div class="offcanvas-footer border-top p-3 bg-white d-flex justify-content-end">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="offcanvas">Hủy</button>
        <button type="button" class="btn btn-primary px-4" id="btnSaveProduct" onclick="saveProduct()">
            <i class="fas fa-save me-1"></i> LƯU SẢN PHẨM
        </button>
    </div>
</div>

<input type="hidden" id="apiBaseUrl" value="@ViewBag.ApiBaseUrl" />
<input type="hidden" id="jwtToken" value="@ViewBag.Token" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const apiUrl = $('#apiBaseUrl').val();
        const token = $('#jwtToken').val();

        let currentPage = 1;
        let pageSize = 10;
        let currentMode = 'create';
        let currentProductData = {};

        const productOffcanvas = new bootstrap.Offcanvas(document.getElementById('offcanvasProduct'));

        $(document).ready(function () {
            loadFormAttributes();
            loadProducts();

            $('#btnSearch').click(function() { currentPage = 1; loadProducts(); });
            $('#searchInput').keypress(function(e) { if (e.which == 13) $('#btnSearch').click(); });
        });

        // 1. GỌI API LẤY DROPDOWN VÀ DATALIST TỪ BACKEND
        function loadFormAttributes() {
            $.ajax({
                url: apiUrl + 'api/admin/products/attributes',
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + token },
                success: function (res) {
                    if (res.isSuccess) {
                        let data = res.data;

                        // Đổ Category vào Select (Bắt buộc chọn)
                        let catHtml = '<option value="">-- Vui lòng chọn danh mục --</option>';
                        data.categories.forEach(c => { catHtml += `<option value="${c.id}">${c.name}</option>`; });
                        $('#CategoryId').html(catHtml);

                        // Đổ các Option vào Datalist để làm Gợi ý động
                        let brandHtml = '';
                        data.brands.forEach(b => { brandHtml += `<option value="${b}">`; });
                        $('#brandList').html(brandHtml);

                        let materialHtml = '';
                        data.materials.forEach(m => { materialHtml += `<option value="${m}">`; });
                        $('#materialList').html(materialHtml);

                        let sizeHtml = '';
                        data.sizes.forEach(s => { sizeHtml += `<option value="${s}">`; });
                        $('#sizeList').html(sizeHtml);

                        let colorHtml = '';
                        data.colors.forEach(c => { colorHtml += `<option value="${c}">`; });
                        $('#colorList').html(colorHtml);
                    }
                },
                error: function () {
                    console.error("Không tải được dữ liệu dropdown");
                }
            });
        }

        // 2. LOAD BẢNG ODATA
        function loadProducts() {
            let skip = (currentPage - 1) * pageSize;
            let odataQuery = `odata/AdminProductsOdata?$count=true&$top=${pageSize}&$skip=${skip}&$orderby=ProductId desc`;

            let keyword = $('#searchInput').val().trim();
            if (keyword) odataQuery += `&$filter=contains(tolower(ProductName), '${keyword.toLowerCase()}')`;

            $.ajax({
                url: apiUrl + odataQuery,
                type: 'GET',
                headers: { 'Authorization': 'Bearer ' + token },
                success: function (response) {
                    if (response && response.value) {
                        renderTable(response.value);
                        renderPagination(response['@@odata.count']);
                    }
                },
                error: function (xhr) {
                    $('#productTableBody').html(`<tr><td colspan="6" class="text-danger text-center py-4">Lỗi tải dữ liệu bảng.</td></tr>`);
                }
            });
        }

        function renderTable(products) {
            let html = '';
            if (products.length === 0) {
                html = `<tr><td colspan="6" class="text-center py-4 text-muted">Không có dữ liệu!</td></tr>`;
            } else {
                products.forEach(p => {
                    let statusHtml = p.IsActive ? `<span class="badge bg-success">Hoạt động</span>` : `<span class="badge bg-danger">Đã ẩn</span>`;
                    let price = p.BasePrice.toLocaleString('vi-VN') + ' đ';

                    html += `
                        <tr>
                            <td>#${p.ProductId}</td>
                            <td><strong>${p.ProductName}</strong><br><small class="text-muted">${p.Slug}</small></td>
                            <td>${p.CategoryName || 'N/A'}</td>
                            <td class="text-danger fw-bold">${price}</td>
                            <td>${statusHtml}</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-info me-1" title="Sửa" onclick="openOffcanvas('edit', ${p.ProductId})">
                                    <i class="fas fa-edit"></i> Sửa
                                </button>
                                <button class="btn btn-sm btn-outline-danger" title="Xóa" onclick="deleteProduct(${p.ProductId})">
                                    <i class="fas fa-trash"></i> Xóa
                                </button>
                            </td>
                        </tr>
                    `;
                });
            }
            $('#productTableBody').html(html);
        }

        function renderPagination(total) {
            let totalPages = Math.ceil(total / pageSize);
            let html = '';
            for (let i = 1; i <= totalPages; i++) {
                html += `<li class="page-item ${currentPage === i ? 'active' : ''}"><a class="page-link" href="#" onclick="currentPage=${i}; loadProducts(); return false;">${i}</a></li>`;
            }
            $('#paginationUl').html(html);
            $('#paginationInfo').text(`Tổng: ${total} sản phẩm`);
        }

        // 3. MỞ OFFCANVAS & ĐIỀN DỮ LIỆU
        function openOffcanvas(mode, id = 0) {
            currentMode = mode;
            $('#productForm')[0].reset();
            $('#variantContainer').empty();
            $('#variantsSection').show();

            $('#CategoryId')[0].setCustomValidity('');
            $('#ProductName')[0].setCustomValidity('');
            $('#BasePrice')[0].setCustomValidity('');

            if (mode === 'create') {
                $('#offcanvasProductLabel').text('THÊM SẢN PHẨM MỚI');
                $('#variantWarningTxt').hide();
                addVariantRow();
                productOffcanvas.show();
            }
            else if (mode === 'edit') {
                $('#offcanvasProductLabel').text('SỬA SẢN PHẨM #' + id);
                $('#variantWarningTxt').show();

                $.ajax({
                    url: apiUrl + `api/admin/products/${id}`,
                    type: 'GET',
                    headers: { 'Authorization': 'Bearer ' + token },
                    success: function (res) {
                        if(res.isSuccess) {
                            let p = res.data;
                            currentProductData = p;

                            $('#ProductId').val(p.productId);
                            $('#CategoryId').val(p.categoryId);
                            $('#ProductName').val(p.productName);

                            $('#Brand').val(p.brand);
                            $('#Material').val(p.material);

                            $('#BasePrice').val(p.basePrice);
                            $('#SalePrice').val(p.salePrice);
                            $('#Description').val(p.description);
                            $('#IsActive').prop('checked', p.isActive);
                            $('#IsFeatured').prop('checked', p.isFeatured);

                            if(p.variants && p.variants.length > 0) {
                                p.variants.forEach(v => {
                                    addVariantRow(v.sku, v.size, v.color, v.extraPrice, v.stockQuantity);
                                });
                            } else {
                                $('#variantContainer').html('<p class="text-muted fst-italic">Sản phẩm này không có biến thể.</p>');
                            }

                            productOffcanvas.show();
                        }
                    },
                    error: function(xhr) {
                        Swal.fire('Lỗi', 'Không thể lấy thông tin chi tiết: ' + xhr.statusText, 'error');
                    }
                });
            }
        }

        // 4. THÊM DÒNG PHÂN LOẠI (Chuyển sang dùng <input> + <datalist>)
        function addVariantRow(sku = '', size = '', color = '', extraPrice = 0, stockQuantity = 0) {
            let rowId = Date.now() + Math.floor(Math.random() * 100);

            let readOnlyAttr = (currentMode === 'edit') ? 'readonly disabled' : '';
            let hideBtnClass = (currentMode === 'edit') ? 'd-none' : '';

            // 🟢 Thay vì select cứng, giờ ta dùng thẻ input text kết hợp datalist
            let rowHtml = `
                <div class="row g-2 mb-2 p-2 border rounded bg-white variant-row shadow-sm" id="row_${rowId}">
                    <div class="col-12 col-md-3">
                        <label class="small text-muted fw-bold">Mã SKU (*)</label>
                        <input type="text" class="form-control form-control-sm v-sku border-primary" value="${sku}" placeholder="Tự tạo..." required ${readOnlyAttr}
                               oninvalid="this.setCustomValidity('Vui lòng nhập mã SKU cho biến thể')"
                               oninput="this.setCustomValidity('')">
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="small text-muted">Kích cỡ</label>
                        <input type="text" class="form-control form-control-sm v-size" list="sizeList" value="${size}" oninput="autoGenerateSku('${rowId}')" placeholder="Chọn hoặc gõ..." autocomplete="off" ${readOnlyAttr}>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="small text-muted">Màu sắc</label>
                        <input type="text" class="form-control form-control-sm v-color" list="colorList" value="${color}" oninput="autoGenerateSku('${rowId}')" placeholder="Chọn hoặc gõ..." autocomplete="off" ${readOnlyAttr}>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="small text-muted">Giá (+)</label>
                        <input type="number" class="form-control form-control-sm v-extra" value="${extraPrice}" placeholder="VNĐ" ${readOnlyAttr}>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="small text-muted fw-bold">Tồn kho (*)</label>
                        <input type="number" class="form-control form-control-sm v-stock border-warning" value="${stockQuantity}" placeholder="SL" required min="0" ${readOnlyAttr}
                               oninvalid="this.setCustomValidity('Tồn kho phải từ 0 trở lên')"
                               oninput="this.setCustomValidity('')">
                    </div>
                    <div class="col-12 col-md-1 d-flex align-items-end ${hideBtnClass}">
                        <button type="button" class="btn btn-sm btn-outline-danger w-100" onclick="$('#row_${rowId}').remove()" title="Xóa dòng này">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            `;
            $('#variantContainer').append(rowHtml);
        }

        // TỰ ĐỘNG TẠO SKU TỪ TÊN SP + SIZE + MÀU
        function autoGenerateSku(rowId) {
            if (currentMode === 'edit') return;

            let productName = $('#ProductName').val();
            let size = $(`#row_${rowId} .v-size`).val();
            let color = $(`#row_${rowId} .v-color`).val();

            if (!productName) return;

            let prefix = productName.split(' ')
                                    .map(word => word.charAt(0))
                                    .join('')
                                    .toUpperCase()
                                    .normalize('NFD').replace(/[\u0300-\u036f]/g, '');

            let colorCode = '';
            if (color) {
                colorCode = '-' + color.split(' ')
                                       .map(w => w.charAt(0))
                                       .join('')
                                       .toUpperCase()
                                       .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            }

            let sizeCode = size ? '-' + size.toUpperCase() : '';
            let randomNum = Math.floor(100 + Math.random() * 900);
            let finalSku = `${prefix}${randomNum}${colorCode}${sizeCode}`;

            $(`#row_${rowId} .v-sku`).val(finalSku);
            $(`#row_${rowId} .v-sku`)[0].setCustomValidity('');
        }

        $(document).on('input', '#ProductName', function() {
            if (currentMode === 'create') {
                this.setCustomValidity('');
                $('.variant-row').each(function() {
                    let rowId = $(this).attr('id').replace('row_', '');
                    autoGenerateSku(rowId);
                });
            }
        });

        // 5. LƯU DỮ LIỆU (POST / PUT)
        function saveProduct() {
            if(!$('#productForm')[0].checkValidity()) {
                $('#productForm')[0].reportValidity();
                return;
            }

            let catId = parseInt($('#CategoryId').val());
            let basePrice = parseFloat($('#BasePrice').val());
            let salePriceInput = $('#SalePrice').val();
            let salePrice = salePriceInput ? parseFloat(salePriceInput) : null;

            let dataPayload = {
                categoryId: catId,
                productName: $('#ProductName').val(),
                brand: $('#Brand').val(), // Nhận cả text gõ tự do
                material: $('#Material').val(), // Nhận cả text gõ tự do
                basePrice: basePrice,
                salePrice: salePrice,
                description: $('#Description').val(),
                isActive: $('#IsActive').is(':checked'),
                isFeatured: $('#IsFeatured').is(':checked'),
                genderTarget: currentProductData.genderTarget || "Unisex",
                isBestSeller: currentProductData.isBestSeller || false,
                isNewArrival: currentProductData.isNewArrival || true
            };

            let ajaxUrl = apiUrl + 'api/admin/products';
            let ajaxMethod = 'POST';

            if (currentMode === 'create') {
                dataPayload.variants = [];
                $('.variant-row').each(function() {
                    dataPayload.variants.push({
                        sku: $(this).find('.v-sku').val(),
                        size: $(this).find('.v-size').val() || null,  // Nhận cả text gõ tự do
                        color: $(this).find('.v-color').val() || null, // Nhận cả text gõ tự do
                        extraPrice: parseFloat($(this).find('.v-extra').val() || 0),
                        stockQuantity: parseInt($(this).find('.v-stock').val() || 0)
                    });
                });

                if(dataPayload.variants.length === 0) {
                    Swal.fire('Cảnh báo', 'Vui lòng thêm ít nhất 1 dòng phân loại SKU!', 'warning');
                    return;
                }
            } else {
                ajaxMethod = 'PUT';
                ajaxUrl += '/' + $('#ProductId').val();
            }

            $.ajax({
                url: ajaxUrl,
                type: ajaxMethod,
                contentType: 'application/json',
                data: JSON.stringify(dataPayload),
                headers: { 'Authorization': 'Bearer ' + token },
                beforeSend: function() {
                    $('#btnSaveProduct').html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');
                    $('#btnSaveProduct').prop('disabled', true);
                },
                success: function (res) {
                    $('#btnSaveProduct').html('<i class="fas fa-save me-1"></i> LƯU SẢN PHẨM').prop('disabled', false);
                    if(res.isSuccess) {
                        productOffcanvas.hide();
                        Swal.fire('Thành công', res.message, 'success');

                        // Gọi lại API load Dropdown/Datalist để cập nhật ngay lập tức các chữ mới gõ
                        loadFormAttributes();

                        loadProducts();
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                },
                error: function (xhr) {
                    $('#btnSaveProduct').html('<i class="fas fa-save me-1"></i> LƯU SẢN PHẨM').prop('disabled', false);
                    let err = xhr.responseJSON?.message || 'Có lỗi xảy ra khi lưu.';
                    Swal.fire('Lỗi', err, 'error');
                }
            });
        }

        // 6. XÓA MỀM (SOFT DELETE)
        function deleteProduct(id) {
            Swal.fire({
                title: 'Khóa sản phẩm?',
                text: "Sản phẩm sẽ bị chuyển trạng thái Ngừng bán thay vì xóa vĩnh viễn để bảo vệ dữ liệu hóa đơn cũ.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: apiUrl + `api/admin/products/${id}`,
                        type: 'DELETE',
                        headers: { 'Authorization': 'Bearer ' + token },
                        success: function (res) {
                            if(res.isSuccess) {
                                Swal.fire('Thành công!', res.message, 'success');
                                loadProducts();
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                            }
                        }
                    });
                }
            });
        }
    </script>
}
```