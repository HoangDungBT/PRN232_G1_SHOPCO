@{
    ViewData["Title"] = "Quản Lý Sản Phẩm ShopCo";
}

<datalist id="brandList"></datalist>
<datalist id="materialList"></datalist>
<datalist id="sizeList"></datalist>
<datalist id="colorList"></datalist>

<div class="card shadow-sm border-0 mt-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold"><i class="fas fa-box text-primary me-2"></i> Danh Sách Sản Phẩm</h5>
        <button class="btn btn-primary btn-sm" onclick="openOffcanvas('create')">
            <i class="fas fa-plus me-1"></i> Thêm Sản Phẩm
        </button>
    </div>
    <div class="card-body">

        <div class="row mb-3 g-2">
            <div class="col-md-3">
                <input type="text" id="searchInput" class="form-control" placeholder="Tên sản phẩm...">
            </div>
            <div class="col-md-2">
                <select id="filterStatus" class="form-select" onchange="resetPageAndLoad()">
                    <option value="all">Tất cả trạng thái</option>
                    <option value="active">Đang mở bán</option>
                    <option value="inactive">Đã dừng bán</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="filterStock" class="form-select" onchange="resetPageAndLoad()">
                    <option value="all">Tất cả tồn kho</option>
                    <option value="lowstock">Sắp hết hàng (!)</option>
                </select>
            </div>
            <div class="col-md-1">
                <button id="btnSearch" class="btn btn-outline-secondary w-100"><i class="fas fa-search"></i> Tìm</button>
            </div>

            <div class="col-md-4 d-flex justify-content-end align-items-center">
                <!-- Nút thao tác hàng loạt (Mặc định ẩn, hiện khi có check) -->
                <div id="bulkActions" class="d-none">
                    <span class="me-2 small text-muted">Đã chọn: <strong id="selectedCount">0</strong></span>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-success" onclick="bulkUpdateStatus(true)" title="Mở bán hàng loạt"><i class="fas fa-play"></i> Mở bán</button>
                        <button type="button" class="btn btn-warning text-dark" onclick="bulkUpdateStatus(false)" title="Dừng bán hàng loạt"><i class="fas fa-pause"></i> Dừng</button>
                        <button type="button" class="btn btn-primary" onclick="bulkUpdateFeatured(true)" title="Đánh dấu nổi bật"><i class="fas fa-star"></i> Nổi bật</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th width="40" class="text-center">
                            <input class="form-check-input" type="checkbox" id="chkSelectAll">
                        </th>
                        <th width="80" class="text-center">Ảnh</th>
                        <th style="cursor: pointer;" onclick="changeSort('ProductName')">Tên Sản Phẩm <i class="fas fa-sort text-muted ms-1 sort-icon" id="sort-ProductName"></i></th>
                        <th style="cursor: pointer;" onclick="changeSort('CategoryName')">Danh Mục <i class="fas fa-sort text-muted ms-1 sort-icon" id="sort-CategoryName"></i></th>
                        <th style="cursor: pointer;" onclick="changeSort('BasePrice')">Giá Gốc <i class="fas fa-sort text-muted ms-1 sort-icon" id="sort-BasePrice"></i></th>
                        <th style="cursor: pointer;" onclick="changeSort('IsActive')">Trạng Thái <i class="fas fa-sort text-muted ms-1 sort-icon" id="sort-IsActive"></i></th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="productTableBody">
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted" id="paginationInfo"></div>
            <nav><ul class="pagination mb-0" id="paginationUl"></ul></nav>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasProduct" aria-labelledby="offcanvasProductLabel" style="width: 700px;">
    <div class="offcanvas-header bg-light border-bottom">
        <h5 class="offcanvas-title fw-bold" id="offcanvasProductLabel">Thêm Sản Phẩm Mới</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form id="productForm">
            <input type="hidden" id="ProductId" value="0" />

            <h6 class="fw-bold text-primary mb-3"><i class="fas fa-info-circle"></i> Thông Tin Cơ Bản</h6>

            <div class="mb-3">
                <label class="form-label fw-bold">Danh Mục (*)</label>
                <select id="CategoryId" class="form-select" required
                        oninvalid="this.setCustomValidity('Vui lòng chọn một danh mục hợp lệ')"
                        oninput="this.setCustomValidity('')">
                    <option value="">-- Đang tải danh mục... --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Tên Sản Phẩm (*)</label>
                <input type="text" id="ProductName" class="form-control" placeholder="VD: Áo thun nam tay ngắn..." required
                       oninvalid="this.setCustomValidity('Tên sản phẩm không được để trống')"
                       oninput="this.setCustomValidity('')" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Thương Hiệu</label>
                    <input type="text" id="Brand" class="form-control" list="brandList" placeholder="Chọn hoặc nhập mới..." autocomplete="off" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Chất Liệu</label>
                    <input type="text" id="Material" class="form-control" list="materialList" placeholder="Chọn hoặc nhập mới..." autocomplete="off" />
                </div>
            </div>

            <div class="row border p-3 bg-light rounded mx-0 mb-3">
                <div class="col-md-6 mb-3 mb-md-0">
                    <label class="form-label fw-bold text-danger">Giá Gốc (*) VNĐ</label>
                    <input type="number" step="1000" id="BasePrice" class="form-control border-danger" required min="1000" placeholder="VD: 150000"
                           oninvalid="this.setCustomValidity('Giá gốc phải phải từ 1,000 VNĐ và chẵn hàng nghìn')"
                           oninput="this.setCustomValidity('')" />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-success">Giá Khuyến Mãi (VNĐ)</label>
                    <input type="number" step="1000" id="SalePrice" class="form-control border-success" min="0" placeholder="Để trống nếu không sale"
                           oninvalid="this.setCustomValidity('Giá khuyến mãi không được là số âm')"
                           oninput="this.setCustomValidity('')" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Mô tả chi tiết</label>
                <textarea id="Description" class="form-control" rows="4" placeholder="Nhập mô tả sản phẩm..."></textarea>
            </div>

            <div class="mb-4 p-3 bg-light border rounded">
                <label class="form-label fw-bold text-primary"><i class="fas fa-images"></i> Hình Ảnh Sản Phẩm</label>
                <input type="file" id="ProductImages" class="form-control" multiple accept="image/*" />
                <small class="text-muted d-block mt-1">Hỗ trợ chọn nhiều file ảnh cùng lúc. Ảnh đầu tiên sẽ làm ảnh đại diện.</small>

                <div id="imagePreviewContainer" class="d-flex flex-wrap gap-3 mt-3"></div>
            </div>

            <div class="row mb-4 bg-light p-2 rounded mx-0">
                <div class="col-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="IsActive" checked>
                        <label class="form-check-label fw-bold">Đang Mở Bán (Active)</label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="IsFeatured">
                        <label class="form-check-label text-warning fw-bold">Sản Phẩm Nổi Bật</label>
                    </div>
                </div>
            </div>

            <div id="variantsSection">
                <div class="d-flex justify-content-between align-items-center mb-2 mt-4 border-top pt-3">
                    <h6 class="fw-bold text-primary m-0"><i class="fas fa-tags"></i> Phân Loại Hàng (Size/Màu) (*)</h6>
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="addVariantRow()">
                        <i class="fas fa-plus"></i> Thêm Phân Loại
                    </button>
                </div>
              
                <div id="variantContainer" class="mb-3">
                </div>
            </div>

        </form>
    </div>
    <div class="offcanvas-footer border-top p-3 bg-white d-flex justify-content-end">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="offcanvas">Hủy</button>
        <button type="button" class="btn btn-primary px-4" id="btnSaveProduct" onclick="saveProduct()">
            <i class="fas fa-save me-1"></i> LƯU SẢN PHẨM
        </button>
    </div>
</div>

<input type="hidden" id="apiBaseUrl" value="@ViewBag.ApiBaseUrl" />
<input type="hidden" id="jwtToken" value="@ViewBag.Token" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const apiUrl = $('#apiBaseUrl').val();
        const token = $('#jwtToken').val();

        let currentPage = 1;
        let pageSize = 10;
        let currentMode = 'create';
        let currentProductData = {};

        // 🟢 QUẢN LÝ TRẠNG THÁI SORT & MẢNG CHECKBOX
        let sortColumn = 'ProductId';
        let sortDirection = 'desc';
        let selectedIds = [];

        let formAttributes = { sizes: [], colors: [] };
        const productOffcanvas = new bootstrap.Offcanvas(document.getElementById('offcanvasProduct'));

        $(document).ready(function () {
            loadFormAttributes();
            loadProducts();

            $('#btnSearch').click(function() { resetPageAndLoad(); });
            $('#searchInput').keypress(function(e) { if (e.which == 13) resetPageAndLoad(); });

            // Xử lý Check All
            $('#chkSelectAll').change(function() {
                $('.chk-item').prop('checked', this.checked);
                updateSelectedIds();
            });
        });

        // 🟢 HÀM LOAD CẤU HÌNH TỪ BACKEND
        function loadFormAttributes() {
            $.ajax({
                url: apiUrl + 'api/admin/products/attributes',
                type: 'GET',
                cache: false,
                headers: { 'Authorization': 'Bearer ' + token },
                success: function (res) {
                    if (res.isSuccess) {
                        let data = res.data;

                        let catHtml = '<option value="">-- Vui lòng chọn danh mục --</option>';
                        data.categories.forEach(c => { catHtml += `<option value="${c.id}">${c.name}</option>`; });
                        $('#CategoryId').html(catHtml);

                        let brandHtml = '';
                        data.brands.forEach(b => { brandHtml += `<option value="${b}">`; });
                        $('#brandList').html(brandHtml);

                        let materialHtml = '';
                        data.materials.forEach(m => { materialHtml += `<option value="${m}">`; });
                        $('#materialList').html(materialHtml);

                        let sizeHtml = '';
                        data.sizes.forEach(s => { sizeHtml += `<option value="${s}">`; });
                        $('#sizeList').html(sizeHtml);

                        let colorHtml = '';
                        data.colors.forEach(c => { colorHtml += `<option value="${c}">`; });
                        $('#colorList').html(colorHtml);

                        formAttributes.sizes = data.sizes;
                        formAttributes.colors = data.colors;
                    }
                },
                error: function () {
                    console.error("Không tải được dữ liệu dropdown");
                }
            });
        }

        function resetPageAndLoad() {
            currentPage = 1;
            loadProducts();
        }

        // 🟢 HÀM ĐỔI CỘT SẮP XẾP ODATA
        function changeSort(column) {
            // Đảo chiều nếu bấm lại cùng 1 cột
            if (sortColumn === column) {
                sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                sortColumn = column;
                sortDirection = 'asc';
            }

            // Cập nhật Icon UI
            $('.sort-icon').removeClass('fa-sort-up fa-sort-down text-primary').addClass('fa-sort text-muted');
            $(`#sort-${column}`).removeClass('fa-sort text-muted')
                                .addClass(sortDirection === 'asc' ? 'fa-sort-up text-primary' : 'fa-sort-down text-primary');

            loadProducts();
        }

        // 🟢 CẬP NHẬT LOAD ODATA KÈM FILTER PHỨC TẠP
        function loadProducts() {
            let skip = (currentPage - 1) * pageSize;

            // Khởi tạo Base OData Query kèm OrderBy động
            let odataQuery = `odata/AdminProductsOdata?$count=true&$top=${pageSize}&$skip=${skip}&$orderby=${sortColumn} ${sortDirection}`;

            // Mảng chứa các điều kiện Lọc (Filter)
            let filters = [];

            // 1. Lọc theo từ khóa
            let keyword = $('#searchInput').val().trim();
            if (keyword) {
                filters.push(`contains(tolower(ProductName), '${keyword.toLowerCase()}')`);
            }

            // 2. Lọc theo Trạng thái
            let status = $('#filterStatus').val();
            if (status === 'active') filters.push(`IsActive eq true`);
            else if (status === 'inactive') filters.push(`IsActive eq false`);

            // 3. Lọc theo Tồn kho
            let stock = $('#filterStock').val();
            if (stock === 'lowstock') filters.push(`HasLowStock eq true`);

            // Gắn mảng Filter vào URL bằng chữ 'and'
            if (filters.length > 0) {
                odataQuery += `&$filter=${filters.join(' and ')}`;
            }

            // Reset UI đa chọn
            $('#chkSelectAll').prop('checked', false);
            selectedIds = [];
            toggleBulkActions();

            $.ajax({
                url: apiUrl + odataQuery,
                type: 'GET',
                cache: false,
                headers: { 'Authorization': 'Bearer ' + token },
                beforeSend: function () {
                    $('#productTableBody').html(`<tr><td colspan="7" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu...</td></tr>`);
                },
                success: function (res) {
                    if (res && res.value) {
                        renderTable(res.value);
                        renderPagination(res['@@odata.count']);
                    }
                },
                error: function () {
                    $('#productTableBody').html(`<tr><td colspan="7" class="text-danger text-center py-4">Lỗi tải dữ liệu bảng.</td></tr>`);
                }
            });
        }

        function renderTable(products) {
            let html = '';
            if (products.length === 0) {
                html = `<tr><td colspan="7" class="text-center py-4 text-muted">Không có dữ liệu!</td></tr>`;
            } else {
                products.forEach(p => {
                    let statusHtml = p.IsActive ? `<span class="badge bg-success">Đang mở bán</span>` : `<span class="badge bg-secondary">Dừng bán</span>`;
                    let price = p.BasePrice.toLocaleString('vi-VN') + ' đ';

                    // 🟢 NẾU SẮP HẾT HÀNG -> Hiện Icon Cảnh Báo
                    let warningIcon = p.HasLowStock ? `<i class="fas fa-exclamation-triangle text-warning ms-2" title="Sắp hết hàng"></i>` : '';

                    let imgHtml = p.ThumbnailUrl
                        ? `<img src="${apiUrl}${p.ThumbnailUrl}" style="width: 50px; height: 50px; object-fit: cover;" class="rounded border" />`
                        : `<div class="bg-light rounded border d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;"><i class="fas fa-image text-muted"></i></div>`;

                    html += `
                        <tr>
                            <td class="text-center align-middle">
                                <input class="form-check-input chk-item" type="checkbox" value="${p.ProductId}" onchange="updateSelectedIds()">
                            </td>
                            <td class="text-center">${imgHtml}</td>
                            <td>
                                <strong>${p.ProductName}</strong> ${warningIcon}<br>
                                <small class="text-muted">Mã ID: #${p.ProductId}</small>
                            </td>
                            <td>${p.CategoryName || 'N/A'}</td>
                            <td class="text-danger fw-bold">${price}</td>
                            <td>${statusHtml}</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-info me-1" title="Sửa" onclick="openOffcanvas('edit', ${p.ProductId})"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-outline-danger" title="Xóa" onclick="deleteProduct(${p.ProductId})"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    `;
                });
            }
            $('#productTableBody').html(html);
        }

        // 🟢 CÁC HÀM XỬ LÝ ĐA CHỌN (BULK ACTION)
        function updateSelectedIds() {
            selectedIds = [];
            $('.chk-item:checked').each(function() {
                selectedIds.push(parseInt($(this).val()));
            });
            toggleBulkActions();
        }

        function toggleBulkActions() {
            $('#selectedCount').text(selectedIds.length);
            if (selectedIds.length > 0) {
                $('#bulkActions').removeClass('d-none').addClass('d-flex');
            } else {
                $('#bulkActions').addClass('d-none').removeClass('d-flex');
            }
        }

        function bulkUpdateStatus(isActive) {
            let actionText = isActive ? 'Mở bán' : 'Dừng bán';
            Swal.fire({
                title: `Xác nhận ${actionText}?`,
                text: `Áp dụng cho ${selectedIds.length} sản phẩm đã chọn.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý',
            }).then((result) => {
                if(result.isConfirmed) {
                    $.ajax({
                        url: apiUrl + 'api/admin/products/bulk/status',
                        type: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify({ productIds: selectedIds, isActive: isActive }),
                        headers: { 'Authorization': 'Bearer ' + token },
                        success: function(res) {
                            Swal.fire('Thành công', res.message, 'success');
                            loadProducts();
                        }
                    });
                }
            });
        }

        function bulkUpdateFeatured(isFeatured) {
            $.ajax({
                url: apiUrl + 'api/admin/products/bulk/featured',
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ productIds: selectedIds, isFeatured: isFeatured }),
                headers: { 'Authorization': 'Bearer ' + token },
                success: function(res) {
                    Swal.fire('Thành công', res.message, 'success');
                    loadProducts();
                }
            });
        }

        function renderPagination(totalRecords) {
            let totalPages = Math.ceil(totalRecords / pageSize);
            let html = '';
            let startRecord = totalRecords === 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
            let endRecord = (currentPage * pageSize) > totalRecords ? totalRecords : (currentPage * pageSize);
            $('#paginationInfo').text(`Hiển thị ${startRecord} - ${endRecord} trên tổng ${totalRecords} sản phẩm`);

            for (let i = 1; i <= totalPages; i++) {
                html += `<li class="page-item ${currentPage === i ? 'active' : ''}"><a class="page-link" href="#" data-page="${i}">${i}</a></li>`;
            }
            $('#paginationUl').html(html);
        }

        $(document).on('click', '.page-link', function (e) {
            e.preventDefault();
            currentPage = parseInt($(this).data('page'));
            loadProducts();
        });

        function openOffcanvas(mode, id = 0) {
            currentMode = mode;
            $('#productForm')[0].reset();
            $('#variantContainer').empty();
            $('#imagePreviewContainer').empty();
            $('#variantsSection').show();

            $('#CategoryId')[0].setCustomValidity('');
            $('#ProductName')[0].setCustomValidity('');
            $('#BasePrice')[0].setCustomValidity('');

            if (mode === 'create') {
                $('#offcanvasProductLabel').text('THÊM SẢN PHẨM MỚI');
                addVariantRow();
                productOffcanvas.show();
            }
            else if (mode === 'edit') {
                $('#offcanvasProductLabel').text('SỬA SẢN PHẨM #' + id);

                $.ajax({
                    url: apiUrl + `api/admin/products/${id}`,
                    type: 'GET',
                    cache: false,
                    headers: { 'Authorization': 'Bearer ' + token },
                    success: function (res) {
                        if(res.isSuccess) {
                            let p = res.data;
                            currentProductData = p;

                            $('#ProductId').val(p.productId);
                            $('#CategoryId').val(p.categoryId);
                            $('#ProductName').val(p.productName);

                            $('#Brand').val(p.brand);
                            $('#Material').val(p.material);

                            $('#BasePrice').val(p.basePrice);
                            $('#SalePrice').val(p.salePrice);
                            $('#Description').val(p.description);
                            $('#IsActive').prop('checked', p.isActive);
                            $('#IsFeatured').prop('checked', p.isFeatured);

                            // 🟢 HIỂN THỊ ẢNH CŨ VÀ THÊM NÚT XÓA ẢNH
                            if(p.images && p.images.length > 0) {
                                let imgPreviewHtml = '';
                                p.images.forEach(img => {
                                    let badge = img.isThumbnail ? '<span class="position-absolute top-0 start-0 badge rounded-0 bg-danger" style="font-size: 0.6rem;">Bìa</span>' : '';
                                    imgPreviewHtml += `
                                        <div class="position-relative d-inline-block" id="img-container-${img.imageId}">
                                            <img src="${apiUrl}${img.imageUrl}" class="rounded border" style="width: 80px; height: 80px; object-fit: cover;" />
                                            ${badge}
                                            <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 translate-end rounded-circle p-0"
                                                    style="width: 22px; height: 22px; line-height: 1;"
                                                    onclick="deleteImage(${img.imageId})" title="Xóa ảnh này">
                                               X
                                            </button>
                                        </div>
                                    `;
                                });
                                $('#imagePreviewContainer').html(imgPreviewHtml);
                            }

                            if(p.variants && p.variants.length > 0) {
                                p.variants.forEach(v => {
                                    addVariantRow(v.sku, v.size, v.color, v.extraPrice, v.stockQuantity);
                                });
                            } else {
                                $('#variantContainer').html('<p class="text-muted fst-italic">Sản phẩm này không có biến thể.</p>');
                            }

                            productOffcanvas.show();
                        }
                    },
                    error: function(xhr) {
                        Swal.fire('Lỗi', 'Không thể lấy thông tin chi tiết.', 'error');
                    }
                });
            }
        }

        // 🟢 HÀM XÓA ẢNH ĐỘC LẬP TỪ CSDL VÀ FOLDER
        function deleteImage(imageId) {
            Swal.fire({
                title: 'Xóa ảnh này?',
                text: "Hành động này sẽ xóa file vật lý trên máy chủ và không thể hoàn tác!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Có, Xóa nó!',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: apiUrl + `api/admin/products/images/${imageId}`, // API backend để xóa ảnh
                        type: 'DELETE',
                        headers: { 'Authorization': 'Bearer ' + token },
                        success: function (res) {
                            if (res.isSuccess) {
                                $(`#img-container-${imageId}`).fadeOut(300, function() { $(this).remove(); });
                                Swal.fire({ title: 'Đã xóa!', icon: 'success', timer: 1000, showConfirmButton: false });
                                loadProducts(); // Reload lại bảng lỡ xóa trúng ảnh đại diện
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                            }
                        },
                        error: function (xhr) {
                            let err = xhr.responseJSON?.message || 'Có lỗi khi xóa ảnh';
                            Swal.fire('Lỗi', err, 'error');
                        }
                    });
                }
            });
        }

        function addVariantRow(sku = '', size = '', color = '', extraPrice = 0, stockQuantity = 0) {
            let rowId = Date.now() + Math.floor(Math.random() * 100);

            let isExisting = (sku !== '') ? 'is-existing' : '';

            let rowHtml = `
                <div class="row g-2 mb-2 p-2 border rounded bg-white variant-row shadow-sm ${isExisting}" id="row_${rowId}">
                    <div class="col-12 col-md-3">
                        <label class="small text-muted fw-bold">Mã SKU (*)</label>
                        <input type="text" class="form-control form-control-sm v-sku border-primary" value="${sku}" placeholder="Tự tạo..." required
                               oninvalid="this.setCustomValidity('Vui lòng nhập mã SKU cho biến thể')"
                               oninput="this.setCustomValidity('')">
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="small text-muted">Kích cỡ</label>
                        <input type="text" class="form-control form-control-sm v-size" list="sizeList" value="${size}" oninput="autoGenerateSku('${rowId}')" placeholder="Chọn/gõ..." autocomplete="off">
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="small text-muted">Màu sắc</label>
                        <input type="text" class="form-control form-control-sm v-color" list="colorList" value="${color}" oninput="autoGenerateSku('${rowId}')" placeholder="Chọn/gõ..." autocomplete="off">
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="small text-muted">Giá (+)</label>
                        <input type="number" step="1000" min="0" class="form-control form-control-sm v-extra" value="${extraPrice}" placeholder="VNĐ"
                         oninvalid="this.setCustomValidity('Giá thêm phải phải từ 0 VNĐ và chẵn hàng nghìn')"
                           oninput="this.setCustomValidity('')"
                        >
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="small text-muted fw-bold">Tồn kho (*)</label>
                        <input type="number" class="form-control form-control-sm v-stock border-warning" value="${stockQuantity}" placeholder="SL" required min="0"
                               oninvalid="this.setCustomValidity('Tồn kho phải từ 0 trở lên')"
                               oninput="this.setCustomValidity('')">
                    </div>
                    <div class="col-12 col-md-1 d-flex align-items-end">
                        <button type="button" class="btn btn-sm btn-outline-danger w-100" onclick="$('#row_${rowId}').remove()" title="Xóa dòng này">
                            <i class="fas fa-times">Xóa</i>
                        </button>
                    </div>
                </div>
            `;
            $('#variantContainer').append(rowHtml);
        }

        function autoGenerateSku(rowId) {
            if ($(`#row_${rowId}`).hasClass('is-existing')) return;

            let productName = $('#ProductName').val();
            let size = $(`#row_${rowId} .v-size`).val();
            let color = $(`#row_${rowId} .v-color`).val();

            if (!productName) return;

            let prefix = productName.split(' ')
                                    .map(word => word.charAt(0))
                                    .join('')
                                    .toUpperCase()
                                    .normalize('NFD').replace(/[\u0300-\u036f]/g, '');

            let colorCode = '';
            if (color) {
                colorCode = '-' + color.split(' ')
                                       .map(w => w.charAt(0))
                                       .join('')
                                       .toUpperCase()
                                       .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            }

            let sizeCode = size ? '-' + size.toUpperCase() : '';
            let randomNum = Math.floor(100 + Math.random() * 900);
            let finalSku = `${prefix}${randomNum}${colorCode}${sizeCode}`;

            $(`#row_${rowId} .v-sku`).val(finalSku);
            $(`#row_${rowId} .v-sku`)[0].setCustomValidity('');
        }

        $(document).on('input', '#ProductName', function() {
            $('.variant-row').not('.is-existing').each(function() {
                let rowId = $(this).attr('id').replace('row_', '');
                autoGenerateSku(rowId);
            });
        });

        async function saveProduct() {
            if(!$('#productForm')[0].checkValidity()) {
                $('#productForm')[0].reportValidity();
                return;
            }

            let catId = parseInt($('#CategoryId').val());
            let basePrice = parseFloat($('#BasePrice').val());
            let salePriceInput = $('#SalePrice').val();
            let salePrice = salePriceInput ? parseFloat(salePriceInput) : null;

            $('#btnSaveProduct').html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...').prop('disabled', true);

            try {
                let uploadedImageUrls = [];
                let files = $('#ProductImages')[0].files;

                if (files.length > 0) {
                    let formData = new FormData();
                    for (let i = 0; i < files.length; i++) {
                        formData.append("images", files[i]);
                    }

                    let uploadRes = await $.ajax({
                        url: apiUrl + 'api/admin/products/upload-images',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        headers: { 'Authorization': 'Bearer ' + token }
                    });

                    if (uploadRes && uploadRes.isSuccess) {
                        uploadedImageUrls = uploadRes.data;
                    } else {
                        Swal.fire('Lỗi', uploadRes.message || 'Upload ảnh thất bại', 'error');
                        $('#btnSaveProduct').html('<i class="fas fa-save me-1"></i> LƯU SẢN PHẨM').prop('disabled', false);
                        return;
                    }
                }

                let variantsArray = [];
                $('.variant-row').each(function() {
                    variantsArray.push({
                        sku: $(this).find('.v-sku').val(),
                        size: $(this).find('.v-size').val() || null,
                        color: $(this).find('.v-color').val() || null,
                        extraPrice: parseFloat($(this).find('.v-extra').val() || 0),
                        stockQuantity: parseInt($(this).find('.v-stock').val() || 0)
                    });
                });

                if(variantsArray.length === 0) {
                    Swal.fire('Cảnh báo', 'Vui lòng thêm ít nhất 1 dòng phân loại SKU!', 'warning');
                    $('#btnSaveProduct').html('<i class="fas fa-save me-1"></i> LƯU SẢN PHẨM').prop('disabled', false);
                    return;
                }

                let dataPayload = {
                    categoryId: catId,
                    productName: $('#ProductName').val(),
                    brand: $('#Brand').val(),
                    material: $('#Material').val(),
                    basePrice: basePrice,
                    salePrice: salePrice,
                    description: $('#Description').val(),
                    isActive: $('#IsActive').is(':checked'),
                    isFeatured: $('#IsFeatured').is(':checked'),
                    genderTarget: currentProductData.genderTarget || "Unisex",
                    isBestSeller: currentProductData.isBestSeller || false,
                    isNewArrival: currentProductData.isNewArrival || true,
                    imageUrls: uploadedImageUrls,
                    variants: variantsArray
                };

                let ajaxUrl = apiUrl + 'api/admin/products';
                let ajaxMethod = 'POST';

                if (currentMode === 'edit') {
                    ajaxMethod = 'PUT';
                    ajaxUrl += '/' + $('#ProductId').val();
                }

                $.ajax({
                    url: ajaxUrl,
                    type: ajaxMethod,
                    contentType: 'application/json',
                    data: JSON.stringify(dataPayload),
                    headers: { 'Authorization': 'Bearer ' + token },
                    success: function (res) {
                        $('#btnSaveProduct').html('<i class="fas fa-save me-1"></i> LƯU SẢN PHẨM').prop('disabled', false);
                        if(res.isSuccess) {
                            productOffcanvas.hide();
                            Swal.fire({ title: 'Thành công', text: res.message, icon: 'success', timer: 1500, showConfirmButton: false });

                            $('#ProductImages').val('');
                            loadFormAttributes();
                            loadProducts();
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                 error: function (xhr) {
                        $('#btnSaveProduct').html('<i class="fas fa-save me-1"></i> LƯU SẢN PHẨM').prop('disabled', false);

                        let errMessage = 'Có lỗi xảy ra khi lưu.';

                        if (xhr.responseJSON) {
                            // 1. Kiểm tra nếu là lỗi do Data Annotation ([Range], [Required]) tự động sinh ra
                            if (xhr.responseJSON.errors) {
                                // Lấy thông báo lỗi đầu tiên trong danh sách errors
                                let firstErrorKey = Object.keys(xhr.responseJSON.errors)[0];
                                errMessage = xhr.responseJSON.errors[firstErrorKey][0];
                            }
                            // 2. Nếu là lỗi do code Backend Service của chúng ta tự trả về (ResultModel)
                            else if (xhr.responseJSON.message) {
                                errMessage = xhr.responseJSON.message;
                            }
                        }

                        Swal.fire('Lỗi Dữ Liệu', errMessage, 'error');
                    }
                });
            } catch (error) {
                $('#btnSaveProduct').html('<i class="fas fa-save me-1"></i> LƯU SẢN PHẨM').prop('disabled', false);
                Swal.fire('Lỗi hệ thống', 'Quá trình tải ảnh lên gặp sự cố, vui lòng thử lại', 'error');
            }
        }

        function deleteProduct(id) {
            Swal.fire({
                title: 'Khóa sản phẩm?',
                text: "Sản phẩm sẽ bị chuyển trạng thái Ngừng bán thay vì xóa vĩnh viễn để bảo vệ dữ liệu hóa đơn cũ.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: apiUrl + `api/admin/products/${id}`,
                        type: 'DELETE',
                        headers: { 'Authorization': 'Bearer ' + token },
                        success: function (res) {
                            if(res.isSuccess) {
                                Swal.fire({ title: 'Thành công!', text: res.message, icon: 'success', timer: 1500, showConfirmButton: false });
                                loadProducts();
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                            }
                        }
                    });
                }
            });
        }
    </script>
}