@{
    ViewData["Title"] = "Quản Lý Danh Mục";
}

<!-- ========================================== -->
<!-- 1. GIAO DIỆN BẢNG DANH SÁCH                -->
<!-- ========================================== -->
<div class="card shadow-sm border-0 mt-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold"><i class="fas fa-list text-primary me-2"></i> Danh Sách Danh Mục</h5>
        <button type="button" class="btn btn-primary btn-sm" onclick="CategoryManager.openOffcanvas('create')">
            <i class="fas fa-plus me-1"></i> Thêm Danh Mục
        </button>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm tên danh mục...">
            </div>
            <div class="col-md-2">
                <button type="button" id="btnSearch" class="btn btn-outline-secondary w-100"><i class="fas fa-search"></i> Tìm</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Tên Danh Mục</th>
                        <th>Danh Mục Cha</th>
                        <th>Thứ tự</th>
                        <th>Trạng Thái</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="categoryTableBody">
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted" id="paginationInfo"></div>
            <nav><ul class="pagination mb-0" id="paginationUl"></ul></nav>
        </div>
    </div>
</div>

<partial name="_CategoryOffcanvas" />

<input type="hidden" id="apiBaseUrl" value="@ViewBag.ApiBaseUrl" />
<input type="hidden" id="jwtToken" value="@ViewBag.Token" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin/common.js" asp-append-version="true"></script>
    <script src="~/js/admin/category.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            const apiUrl = $('#apiBaseUrl').val();
            const token = $('#jwtToken').val();
            CategoryManager.init(apiUrl, token);
        });
    </script>
}