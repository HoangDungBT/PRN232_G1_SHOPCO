@{
    ViewData["Title"] = "Quản Lý Danh Mục";
}

<!-- ========================================== -->
<!-- 1. GIAO DIỆN BẢNG DANH SÁCH                -->
<!-- ========================================== -->
<div class="card shadow-sm border-0 mt-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold"><i class="fas fa-list text-primary me-2"></i> Danh Sách Danh Mục</h5>
        <button type="button" class="btn btn-primary btn-sm" onclick="openOffcanvas('create')">
            <i class="fas fa-plus me-1"></i> Thêm Danh Mục
        </button>
    </div>
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm tên danh mục...">
            </div>
            <div class="col-md-2">
                <button type="button" id="btnSearch" class="btn btn-outline-secondary w-100"><i class="fas fa-search"></i> Tìm</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Tên Danh Mục</th>
                        <th>Danh Mục Cha</th>
                        <th>Thứ tự</th>
                        <th>Trạng Thái</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="categoryTableBody">
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted" id="paginationInfo"></div>
            <nav><ul class="pagination mb-0" id="paginationUl"></ul></nav>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 2. OFFCANVAS FORM (THÊM / SỬA)             -->
<!-- ========================================== -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasCategory" aria-labelledby="offcanvasCategoryLabel" style="width: 500px;">
    <div class="offcanvas-header bg-light border-bottom">
        <h5 class="offcanvas-title fw-bold" id="offcanvasCategoryLabel">Thêm Danh Mục Mới</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form id="categoryForm">
            <input type="hidden" id="CategoryId" value="0" />

            <div class="mb-3">
                <label class="form-label fw-bold">Tên Danh Mục (*)</label>
                <input type="text" id="CategoryName" class="form-control" placeholder="VD: Thời trang Nam" required
                       oninvalid="this.setCustomValidity('Vui lòng nhập tên danh mục')"
                       oninput="this.setCustomValidity('')" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Danh Mục Cha (Tùy chọn)</label>
                <select id="ParentCategoryId" class="form-select">
                    <option value="">-- Đây là danh mục gốc --</option>
                </select>
                <small class="text-muted">Để trống nếu đây là danh mục cấp 1.</small>
            </div>

            <div class="mb-3">
                <label class="form-label">Đường dẫn ảnh (Tùy chọn)</label>
                <input type="text" id="ImageUrl" class="form-control" placeholder="https://..." />
            </div>

            <div class="mb-3">
                <label class="form-label">Mô tả</label>
                <textarea id="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Thứ tự hiển thị</label>
                    <input type="number" id="SortOrder" class="form-control" value="0" min="0" required />
                </div>
                <div class="col-md-6 mb-3 d-flex align-items-end pb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="IsActive" checked>
                        <label class="form-check-label fw-bold">Đang hoạt động</label>
                    </div>
                </div>
            </div>

        </form>
    </div>
    <div class="offcanvas-footer border-top p-3 bg-white d-flex justify-content-end">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="offcanvas">Hủy</button>
        <button type="button" class="btn btn-primary px-4" id="btnSaveCategory" onclick="saveCategory()">
            <i class="fas fa-save me-1"></i> LƯU DỮ LIỆU
        </button>
    </div>
</div>

<input type="hidden" id="apiBaseUrl" value="@ViewBag.ApiBaseUrl" />
<input type="hidden" id="jwtToken" value="@ViewBag.Token" />

<!-- ========================================== -->
<!-- 3. JAVASCRIPT XỬ LÝ                        -->
<!-- ========================================== -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const apiUrl = $('#apiBaseUrl').val();
        const token = $('#jwtToken').val();

        let currentPage = 1;
        let pageSize = 10;
        let currentMode = 'create';

        const categoryOffcanvas = new bootstrap.Offcanvas(document.getElementById('offcanvasCategory'));

        $(document).ready(function () {
            loadCategories();
            loadParentCategoriesForDropdown();

            $('#btnSearch').click(function() { currentPage = 1; loadCategories(); });
            $('#searchInput').keypress(function(e) { if (e.which == 13) $('#btnSearch').click(); });
        });

        // 1. TẢI DANH MỤC CHA (Cho Dropdown)
        function loadParentCategoriesForDropdown() {
            let query = `odata/AdminCategoriesOData?$filter=IsActive eq true&$orderby=CategoryName asc`;
            $.ajax({
                url: apiUrl + query,
                type: 'GET',
                cache: false, // 🟢 NGĂN TRÌNH DUYỆT LƯU CACHE
                headers: { 'Authorization': 'Bearer ' + token },
                success: function (res) {
                    if (res && res.value) {
                        let html = '<option value="">-- Đây là danh mục gốc --</option>';
                        res.value.forEach(c => {
                            html += `<option value="${c.CategoryId}">${c.CategoryName}</option>`;
                        });
                        $('#ParentCategoryId').html(html);
                    }
                }
            });
        }

        // 2. LOAD BẢNG ODATA
        function loadCategories() {
            let skip = (currentPage - 1) * pageSize;

            let odataQuery = `odata/AdminCategoriesOData?$count=true&$top=${pageSize}&$skip=${skip}&$orderby=CategoryId desc`;

            let keyword = $('#searchInput').val().trim();
            if (keyword) odataQuery += `&$filter=contains(tolower(CategoryName), '${keyword.toLowerCase()}')`;

            $.ajax({
                url: apiUrl + odataQuery,
                type: 'GET',
                cache: false,
                headers: { 'Authorization': 'Bearer ' + token },
                beforeSend: function () {
                    $('#categoryTableBody').html(`<tr><td colspan="6" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu...</td></tr>`);
                },
                success: function (response) {
                    if (response && response.value) {
                        renderTable(response.value);
                        renderPagination(response['@@odata.count']);
                    }
                },
                error: function (xhr) {
                    $('#categoryTableBody').html(`<tr><td colspan="6" class="text-danger text-center py-4">Lỗi tải dữ liệu.</td></tr>`);
                }
            });
        }

        function renderTable(categories) {
            let html = '';
            if (categories.length === 0) {
                html = `<tr><td colspan="6" class="text-center py-4 text-muted">Không có dữ liệu!</td></tr>`;
            } else {
                categories.forEach(c => {
                    let statusHtml = c.IsActive ? `<span class="badge bg-success">Hoạt động</span>` : `<span class="badge bg-danger">Đã khóa</span>`;
                    let parentName = c.ParentCategoryName
                    ? `<span class="badge bg-secondary">${c.ParentCategoryName}</span>`
                    : `<span class="text-muted fst-italic">Danh mục gốc</span>`;
                    
                    let lockBtnClass = c.IsActive ? 'btn-outline-danger' : 'btn-outline-success';
                    let lockIcon = c.IsActive ? 'fa-lock' : 'fa-unlock';
                    let lockTitle = c.IsActive ? 'Khóa' : 'Mở khóa';

                    html += `
                        <tr>
                            <td>#${c.CategoryId}</td>
                            <td><strong>${c.CategoryName}</strong><br><small class="text-muted">/${c.Slug}</small></td>
                            <td>${parentName}</td>
                            <td class="text-center">${c.SortOrder}</td>
                            <td>${statusHtml}</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-info me-1" title="Sửa" onclick="openOffcanvas('edit', ${c.CategoryId})">
                                    <i class="fas fa-edit"></i>
                                </button>

                                 <button class="btn btn-sm ${lockBtnClass}" title="${lockTitle}" onclick="toggleCategoryStatus(${c.CategoryId})">
                                <i class="fas ${lockIcon}"></i>
                            </button>
                            </td>
                        </tr>
                    `;
                });
            }
            $('#categoryTableBody').html(html);
        }

        function renderPagination(total) {
            let totalPages = Math.ceil(total / pageSize);
            let html = '';
            for (let i = 1; i <= totalPages; i++) {
                html += `<li class="page-item ${currentPage === i ? 'active' : ''}"><a class="page-link" href="#" onclick="currentPage=${i}; loadCategories(); return false;">${i}</a></li>`;
            }
            $('#paginationUl').html(html);
            $('#paginationInfo').text(`Tổng: ${total} danh mục`);
        }

        // 3. MỞ OFFCANVAS & ĐIỀN DỮ LIỆU
        function openOffcanvas(mode, id = 0) {
            currentMode = mode;
            $('#categoryForm')[0].reset();
            $('#CategoryName')[0].setCustomValidity('');

            $('#ParentCategoryId option').prop('disabled', false);

            if (mode === 'create') {
                $('#offcanvasCategoryLabel').text('THÊM DANH MỤC MỚI');
                $('#SortOrder').val(0);
                categoryOffcanvas.show();
            }
            else if (mode === 'edit') {
                $('#offcanvasCategoryLabel').text('SỬA DANH MỤC #' + id);

                $(`#ParentCategoryId option[value='${id}']`).prop('disabled', true);

                $.ajax({
                    url: apiUrl + `api/admin/categories/${id}`,
                    type: 'GET',
                    cache: false, // 🟢 NGĂN TRÌNH DUYỆT LƯU CACHE
                    headers: { 'Authorization': 'Bearer ' + token },
                    success: function (res) {
                        if(res.isSuccess) {
                            let c = res.data;

                            $('#CategoryId').val(c.categoryId);
                            $('#ParentCategoryId').val(c.parentCategoryId || '');
                            $('#CategoryName').val(c.categoryName);
                            $('#ImageUrl').val(c.imageUrl);
                            $('#Description').val(c.description);
                            $('#SortOrder').val(c.sortOrder);
                            $('#IsActive').prop('checked', c.isActive);

                            categoryOffcanvas.show();
                        }
                    },
                    error: function(xhr) {
                        Swal.fire('Lỗi', 'Không thể lấy thông tin chi tiết.', 'error');
                    }
                });
            }
        }

        // 4. LƯU DỮ LIỆU (POST / PUT)
        function saveCategory() {
            if(!$('#categoryForm')[0].checkValidity()) {
                $('#categoryForm')[0].reportValidity();
                return;
            }

            let parentId = $('#ParentCategoryId').val();

            let dataPayload = {
                parentCategoryId: parentId ? parseInt(parentId) : null,
                categoryName: $('#CategoryName').val(),
                description: $('#Description').val(),
                imageUrl: $('#ImageUrl').val(),
                sortOrder: parseInt($('#SortOrder').val()) || 0,
                isActive: $('#IsActive').is(':checked')
            };

            let ajaxUrl = apiUrl + 'api/admin/categories';
            let ajaxMethod = 'POST';

            if (currentMode === 'edit') {
                ajaxMethod = 'PUT';
                ajaxUrl += '/' + $('#CategoryId').val();
            }

            $.ajax({
                url: ajaxUrl,
                type: ajaxMethod,
                contentType: 'application/json',
                data: JSON.stringify(dataPayload),
                headers: { 'Authorization': 'Bearer ' + token },
                beforeSend: function() {
                    $('#btnSaveCategory').html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');
                    $('#btnSaveCategory').prop('disabled', true);
                },
                success: function (res) {
                    $('#btnSaveCategory').html('<i class="fas fa-save me-1"></i> LƯU DỮ LIỆU').prop('disabled', false);
                    if(res.isSuccess) {
                        categoryOffcanvas.hide();

                        Swal.fire({
                            title: 'Thành công',
                            text: res.message,
                            icon: 'success',
                            timer: 1500, // Tự động đóng sau 1.5s
                            showConfirmButton: false
                        });

                        // 🟢 Load lại ngay lập tức
                        loadCategories();
                        loadParentCategoriesForDropdown();
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                },
                error: function (xhr) {
                    $('#btnSaveCategory').html('<i class="fas fa-save me-1"></i> LƯU DỮ LIỆU').prop('disabled', false);
                    let err = xhr.responseJSON?.message || 'Có lỗi xảy ra khi lưu.';
                    Swal.fire('Lỗi', err, 'error');
                }
            });
        }

               function toggleCategoryStatus(id) {
            Swal.fire({
                title: 'Xác nhận thay đổi?',
                text: "Bạn muốn thay đổi trạng thái hoạt động của danh mục này?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Đồng ý'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: apiUrl + `api/admin/categories/${id}/status`,
                        type: 'PUT',
                        headers: { 'Authorization': 'Bearer ' + token },
                        success: function (res) {
                            if (res.isSuccess) {
                                Swal.fire({
                                    title: 'Thành công!',
                                    text: res.message,
                                    icon: 'success',
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                                loadCategories(); // Reload lại bảng
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                            }
                        },
                        error: function(xhr) {
                            Swal.fire('Lỗi', 'Không thể thay đổi trạng thái', 'error');
                        }
                    });
                }
            });
        }
    </script>
}