@{
    ViewData["Title"] = "Quản Lý Kho";
}
<div class="card shadow-sm border-0 mt-3">
    <div class="card-header bg-white">
        <h5 class="mb-0 fw-bold"><i class="fas fa-warehouse me-2"></i> Quản Lý Tồn Kho</h5>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4">
                <div class="input-group">
                    <input type="text" id="searchInput" class="form-control" placeholder="Tìm tên sản phẩm...">
                    <button class="btn btn-outline-secondary" id="btnSearch"><i class="fas fa-search"></i> Tìm</button>
                </div>
            </div>
        </div>
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Sản phẩm</th>
                    <th>SKU</th>
                    <th>Mẫu</th>
                    <th>Còn lại</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody id="inventoryBody">
                <!-- Data đổ từ OData -->
            </tbody>
        </table>
        
        <!-- Phân trang -->
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-end" id="paginationUl">
            </ul>
        </nav>
    </div>
</div>

<!-- Modal Điều chỉnh -->
<div class="modal fade" id="adjustModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Điều chỉnh tồn kho</h5>
            </div>
            <div class="modal-body">
                <input type="hidden" id="vId" />
                <input type="number" id="qChange" class="form-control" placeholder="Số lượng (+/-)">
                <input type="text" id="reason" class="form-control mt-2" placeholder="Lý do">
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" onclick="InventoryManager.submitAdjust()">Xác nhận</button> 
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="apiBaseUrl" value="@ViewBag.ApiBaseUrl" />
<input type="hidden" id="jwtToken" value="@ViewBag.Token" />

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/admin/common.js" asp-append-version="true"></script>
    <script src="~/js/admin/inventory.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            const apiUrl = $('#apiBaseUrl').val();
            const token = $('#jwtToken').val();
            InventoryManager.init(apiUrl, token);
        });
    </script>
}