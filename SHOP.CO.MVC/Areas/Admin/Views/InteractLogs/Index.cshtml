@{
    ViewData["Title"] = "Lịch Sử Hệ Thống";
}

<!-- -->
<div class="card shadow-sm border-0 mt-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 fw-bold"><i class="fas fa-history text-secondary me-2"></i> Nhật Ký Hoạt Động (Logs)</h5>
        <button class="btn btn-sm btn-outline-secondary" onclick="InteractLogManager.loadLogs()"><i class="fas fa-sync-alt"></i> Làm mới</button>
    </div>
    <div class="card-body">

        <!-- BỘ LỌC TÌM KIẾM -->
        <div class="row mb-3 g-2">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Tìm theo người dùng, thông báo...">
            </div>
            <div class="col-md-3">
                <select id="filterLogType" class="form-select" onchange="InteractLogManager.resetPageAndLoad()">
                    <option value="all">Tất cả loại Log</option>
                    <option value="StockMovement">Điều chỉnh kho (StockMovement)</option>
                    <option value="StockAlert">Cảnh báo kho (StockAlert)</option>
                    <option value="Audit">Bảo mật & Hệ thống (Audit)</option>
                    <option value="Chatbot">Tương tác Chatbot</option>
                </select>
            </div>
            <div class="col-md-2">
                <button id="btnSearch" class="btn btn-outline-secondary w-100" onclick="InteractLogManager.resetPageAndLoad()"><i class="fas fa-search"></i> Tìm</button>
            </div>
        </div>

        <!-- BẢNG DỮ LIỆU -->
        <div class="table-responsive">
            <table class="table table-hover align-middle border-bottom">
                <thead class="table-light text-muted small">
                    <tr>
                        <th width="80">ID</th>
                        <th width="150">Thời Gian</th>
                        <th width="150">Loại Log</th>
                        <th width="180">Tác Nhân</th>
                        <th>Nội Dung</th>
                        <th width="80" class="text-center">Chi tiết</th>
                    </tr>
                </thead>
                <tbody id="logTableBody">
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted small" id="paginationInfo"></div>
            <nav><ul class="pagination pagination-sm mb-0" id="paginationUl"></ul></nav>
        </div>
    </div>
</div>

<!-- -->
<div class="modal fade" id="logDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fas fa-code text-primary me-2"></i> Chi tiết dữ liệu Log</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bg-dark text-white p-4" style="border-radius: 0 0 0.3rem 0.3rem;">
                <h6 class="text-info fw-bold mb-2">Old Value / Payload:</h6>
                <pre><code id="jsonOldValue" class="language-json text-warning" style="white-space: pre-wrap; word-wrap: break-word;">Không có dữ liệu</code></pre>

                <hr class="border-secondary">

                <h6 class="text-success fw-bold mb-2">New Value / Result:</h6>
                <pre><code id="jsonNewValue" class="language-json text-success" style="white-space: pre-wrap; word-wrap: break-word;">Không có dữ liệu</code></pre>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="apiBaseUrl" value="@ViewBag.ApiBaseUrl" />
<input type="hidden" id="jwtToken" value="@ViewBag.Token" />

@section Scripts {
    <script src="~/js/admin/common.js" asp-append-version="true"></script>
    <script src="~/js/admin/interactlogs.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            const apiUrl = $('#apiBaseUrl').val();
            const token = $('#jwtToken').val();
            InteractLogManager.init(apiUrl, token);
        });
    </script>
}